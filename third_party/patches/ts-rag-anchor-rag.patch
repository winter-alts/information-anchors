new file mode 100644
index 0000000..2652190
--- /dev/null
+++ b/TS-RAG/models/mi_attention_prior.py
@@ -0,0 +1,193 @@
+"""History-only MI priors for the TS-RAG ARM attention mask.
+
+The helper intentionally has no PyTorch import at module load time.  This keeps
+the score-layout tests runnable in the lightweight repository environment while
+the tensor path is used by the Chronos-Bolt model at inference time.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+
+import numpy as np
+
+
+def _validate_prior_shape(prior_scores: Any) -> tuple[int, int]:
+    shape = getattr(prior_scores, "shape", None)
+    ndim = getattr(prior_scores, "ndim", None)
+    if ndim != 2 or shape is None:
+        raise ValueError(
+            f"MI attention prior must have shape [batch, candidates], got {shape}"
+        )
+    batch_size, candidates = int(shape[0]), int(shape[1])
+    if batch_size <= 0 or candidates <= 0:
+        raise ValueError("MI attention prior must contain at least one batch and candidate")
+    return batch_size, candidates
+
+
+def _numpy_head_mask(head_mask: Any, num_heads: int) -> np.ndarray:
+    mask = np.asarray(head_mask, dtype=np.float32)
+    if mask.shape != (int(num_heads),) or not np.isfinite(mask).all():
+        raise ValueError(f"head_mask must have shape [{num_heads}] and be finite")
+    if not np.all(np.isin(mask, [0.0, 1.0])):
+        raise ValueError("head_mask must contain only 0/1 values")
+    return mask
+
+
+def _numpy_bias(
+    prior_scores: np.ndarray,
+    num_heads: int,
+    strength: float,
+    clip: float,
+    head_mask: Any = None,
+) -> np.ndarray:
+    values = np.asarray(prior_scores, dtype=np.float32)
+    if not np.isfinite(values).all():
+        raise ValueError("MI attention prior contains non-finite values")
+    centered = values - values.mean(axis=1, keepdims=True)
+    scale = np.maximum(values.std(axis=1, keepdims=True), 1e-6)
+    normalized = np.clip(centered / scale, -clip, clip) * strength
+    batch_size, candidates = values.shape
+    sequence_length = candidates + 1
+    bias = np.zeros(
+        (batch_size, num_heads, sequence_length, sequence_length),
+        dtype=np.float32,
+    )
+    # Token 0 is the query.  Only query -> retrieved-future edges receive MI.
+    selected = (
+        np.ones(int(num_heads), dtype=np.float32)
+        if head_mask is None
+        else _numpy_head_mask(head_mask, num_heads)
+    )
+    bias[:, :, 0, 1:] = normalized[:, None, :] * selected[None, :, None]
+    return bias.reshape(batch_size * num_heads, sequence_length, sequence_length)
+
+
+def _tensor_bias(
+    prior_scores: Any,
+    num_heads: int,
+    strength: float,
+    clip: float,
+    head_mask: Any = None,
+) -> Any:
+    import torch
+
+    values = prior_scores
+    if not torch.isfinite(values).all():
+        raise ValueError("MI attention prior contains non-finite values")
+    centered = values - values.mean(dim=1, keepdim=True)
+    scale = values.std(dim=1, keepdim=True, unbiased=False).clamp_min(1e-6)
+    normalized = (centered / scale).clamp(-clip, clip) * strength
+    batch_size, candidates = values.shape
+    sequence_length = candidates + 1
+    bias = values.new_zeros((batch_size, num_heads, sequence_length, sequence_length))
+    if head_mask is None:
+        selected = values.new_ones((int(num_heads),))
+    else:
+        selected = torch.as_tensor(head_mask, device=values.device, dtype=values.dtype)
+        if selected.shape != (int(num_heads),) or not torch.isfinite(selected).all():
+            raise ValueError(f"head_mask must have shape [{num_heads}] and be finite")
+        if not torch.all((selected == 0) | (selected == 1)):
+            raise ValueError("head_mask must contain only 0/1 values")
+    bias[:, :, 0, 1:] = normalized.unsqueeze(1) * selected.view(1, -1, 1)
+    return bias.reshape(batch_size * num_heads, sequence_length, sequence_length)
+
+
+def build_query_attention_bias(
+    prior_scores: Any,
+    *,
+    num_heads: int,
+    strength: float = 1.0,
+    clip: float = 2.0,
+    head_mask: Any = None,
+) -> Any:
+    """Build an ``nn.MultiheadAttention`` additive mask from high-is-better scores.
+
+    ``prior_scores`` is ``[batch, candidates]`` and candidates with larger
+    scores receive a larger query-to-candidate attention logit.  The returned
+    mask is ``[batch * num_heads, candidates + 1, candidates + 1]``.  All
+    entries are zero except row 0, columns 1..K, so candidate-candidate
+    interactions and the query self-edge remain unchanged.
+    """
+    if prior_scores is None:
+        return None
+    if int(num_heads) <= 0:
+        raise ValueError("num_heads must be positive")
+    if not np.isfinite(float(strength)) or float(strength) < 0.0:
+        raise ValueError("strength must be finite and non-negative")
+    if not np.isfinite(float(clip)) or float(clip) <= 0.0:
+        raise ValueError("clip must be finite and positive")
+    _validate_prior_shape(prior_scores)
+    if isinstance(prior_scores, np.ndarray):
+        return _numpy_bias(
+            prior_scores, int(num_heads), float(strength), float(clip), head_mask
+        )
+    return _tensor_bias(
+        prior_scores, int(num_heads), float(strength), float(clip), head_mask
+    )
+
+
+def query_reference_attention_mass_per_head(attention_weights: Any) -> Any:
+    """Extract query-to-reference weights without averaging heads."""
+
+    shape = getattr(attention_weights, "shape", None)
+    ndim = getattr(attention_weights, "ndim", None)
+    if ndim not in {3, 4} or shape is None:
+        raise ValueError("attention weights must have shape [B,L,S] or [B,H,L,S]")
+    if int(shape[-2]) != int(shape[-1]) or int(shape[-1]) < 2:
+        raise ValueError("attention weights must be square with query and reference tokens")
+    if isinstance(attention_weights, np.ndarray):
+        values = np.asarray(attention_weights, dtype=np.float32)
+        if not np.isfinite(values).all():
+            raise ValueError("attention weights contain non-finite values")
+        if ndim == 4:
+            return values[:, :, 0, 1:]
+        return values[:, None, 0, 1:]
+
+    import torch
+
+    if not torch.isfinite(attention_weights).all():
+        raise ValueError("attention weights contain non-finite values")
+    if ndim == 4:
+        return attention_weights[:, :, 0, 1:]
+    return attention_weights[:, None, 0, 1:]
+
+
+def query_reference_attention_mass(attention_weights: Any) -> Any:
+    """Extract query-to-reference mass from ``MultiheadAttention`` weights.
+
+    The query is token 0 and retrieved references occupy tokens 1..K.  Both
+    PyTorch's per-head ``[B,H,L,S]`` weights and averaged ``[B,L,S]`` weights
+    are accepted.  Per-head weights are averaged only after selecting the
+    query row, keeping the diagnostic independent of head count.
+    """
+
+    shape = getattr(attention_weights, "shape", None)
+    ndim = getattr(attention_weights, "ndim", None)
+    if ndim not in {3, 4} or shape is None:
+        raise ValueError("attention weights must have shape [B,L,S] or [B,H,L,S]")
+    if int(shape[-2]) != int(shape[-1]) or int(shape[-1]) < 2:
+        raise ValueError("attention weights must be square with query and reference tokens")
+
+    if isinstance(attention_weights, np.ndarray):
+        values = np.asarray(attention_weights, dtype=np.float32)
+        if not np.isfinite(values).all():
+            raise ValueError("attention weights contain non-finite values")
+        if ndim == 4:
+            return values[:, :, 0, 1:].mean(axis=1)
+        return values[:, 0, 1:]
+
+    import torch
+
+    if not torch.isfinite(attention_weights).all():
+        raise ValueError("attention weights contain non-finite values")
+    if ndim == 4:
+        return attention_weights[:, :, 0, 1:].mean(dim=1)
+    return attention_weights[:, 0, 1:]
+
+
+__all__ = [
+    "build_query_attention_bias",
+    "query_reference_attention_mass",
+    "query_reference_attention_mass_per_head",
+]
