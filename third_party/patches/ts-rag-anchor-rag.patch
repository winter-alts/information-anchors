+def _align_retrieved_future_recent_ewmean(
+    context: torch.Tensor,
+    retrieved_x: torch.Tensor,
+    retrieved_y: torch.Tensor,
+    *,
+    window: int = 96,
+    tau: float = 32.0,
+) -> torch.Tensor:
+    """Align retrieved futures to the query's recent normalized level."""
+
+    if context.ndim != 2 or retrieved_x.ndim != 3 or retrieved_y.ndim != 3:
+        raise ValueError("alignment inputs must be [B,S], [B,K,S], and [B,K,P]")
+    if retrieved_x.shape[:2] != retrieved_y.shape[:2]:
+        raise ValueError("retrieved history/future candidate dimensions do not match")
+    if int(window) <= 0:
+        raise ValueError("retrieved alignment window must be positive")
+    if float(tau) <= 0.0:
+        raise ValueError("retrieved alignment tau must be positive")
+
+    recent = min(int(window), context.shape[-1], retrieved_x.shape[-1])
+    if recent <= 0:
+        raise ValueError("retrieved alignment requires non-empty histories")
+
+    age = torch.arange(
+        recent - 1,
+        -1,
+        -1,
+        device=context.device,
+        dtype=context.dtype,
+    )
+    weights = torch.exp(-age / float(tau))
+    weights = weights / weights.sum()
+
+    query_recent = (
+        context[..., -recent:] * weights.view(1, -1)
+    ).sum(dim=-1, keepdim=True)
+    candidate_recent = (
+        retrieved_x[..., -recent:] * weights.view(1, 1, -1)
+    ).sum(dim=-1, keepdim=True)
+
+    return retrieved_y + query_recent[:, None, :] - candidate_recent
+
