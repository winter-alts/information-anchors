+def _boundary_conditioned_shape_alignment(
+    context: torch.Tensor,
+    candidate_history: torch.Tensor,
+    candidate_future: torch.Tensor,
+) -> torch.Tensor:
+    """Align candidate futures using query/candidate histories only.
+
+    The transformation transfers the candidate's robust first-order shape to
+    the query endpoint.  It is the differentiable in-model counterpart of the
+    experiment runner's BCSA treatment and never uses the query future.
+    """
 
-        config.vocab_size = 2 if self.chronos_config.use_reg_token else 1
-        self.shared = nn.Embedding(config.vocab_size, config.d_model)
+    if context.ndim != 2 or candidate_history.ndim != 3 or candidate_future.ndim != 3:
+        raise ValueError("BCSA inputs must be [B,S], [B,K,S], and [B,K,H]")
+    if context.shape[0] != candidate_history.shape[0]:
+        raise ValueError("BCSA batch dimensions do not match")
+    if candidate_history.shape[:2] != candidate_future.shape[:2]:
+        raise ValueError("BCSA candidate dimensions do not match")
+    eps = 1e-6
+    query_delta = context[:, 1:] - context[:, :-1]
+    candidate_delta = candidate_history[..., 1:] - candidate_history[..., :-1]
+    query_median = query_delta.median(dim=1).values
+    candidate_median = candidate_delta.median(dim=2).values
+    query_mad = (query_delta - query_median[:, None]).abs().median(dim=1).values
+    candidate_mad = (
+        (candidate_delta - candidate_median[..., None])
+        .abs()
+        .median(dim=2)
+        .values
+    )
+    ratio = torch.sqrt(
+        (query_mad[:, None] + eps) / (candidate_mad + eps)
+    ).clamp(0.05, 20.0)
+    return context[:, None, -1:] + ratio[..., None] * (
+        candidate_future - candidate_history[..., -1:]
+    )
