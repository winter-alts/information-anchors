+class CausalSetEvidenceAdapter(nn.Module):
+    """Multi-scale kernel set adapter for replacing the TS-RAG ARM.
+
+    CSEA keeps the retrieved pairs as an unordered evidence set.  It uses
+    temporal summaries at two resolutions, a query--candidate kernel rather
+    than multi-head attention, and an explicit evidence-dispersion statistic
+    to gate a hidden-space residual.  No candidate trajectory is copied into
+    forecast space and no official ARM parameter is used at inference.
+    """
+
+    def __init__(
+        self,
+        d_model: int,
+        context_length: int = 512,
+        prediction_length: int = 64,
+        raw_hidden_dim: int | None = None,
+        hidden_dim: int | None = None,
+        key_dim: int | None = None,
+        bottleneck_dim: int | None = None,
+    ) -> None:
+        super().__init__()
+        self.d_model = int(d_model)
+        self.context_length = int(context_length)
+        self.prediction_length = int(prediction_length)
+        # The default width preserves the original CSEA pilot.  The formal
+        # ``csea_fair`` variant passes narrower widths so its trainable
+        # capacity is explicitly below the official MoE ARM capacity.
+        raw_hidden = int(raw_hidden_dim or self.d_model)
+        hidden = int(hidden_dim or max(self.d_model // 2, 32))
+        key_width = int(key_dim or max(self.d_model // 4, 32))
+        bottleneck = int(bottleneck_dim or max(self.d_model // 8, 32))
+        if min(raw_hidden, hidden, key_width, bottleneck) <= 0:
+            raise ValueError("CSEA internal widths must be positive")
+
+        self.query_raw = nn.Sequential(
+            nn.Linear(self.context_length, raw_hidden),
+            nn.GELU(),
+            nn.Linear(raw_hidden, self.d_model),
+        )
+        self.history_raw = nn.Sequential(
+            nn.Linear(self.context_length, raw_hidden),
+            nn.GELU(),
+            nn.Linear(raw_hidden, self.d_model),
+        )
+        self.future_raw = nn.Sequential(
+            nn.Linear(self.prediction_length, raw_hidden),
+            nn.GELU(),
+            nn.Linear(raw_hidden, self.d_model),
+        )
+        self.query_patch = nn.Linear(5, self.d_model)
+        self.history_patch = nn.Linear(5, self.d_model)
+        self.future_patch = nn.Linear(5, self.d_model)
+        self.query_norm = nn.LayerNorm(self.d_model)
+        self.candidate_norm = nn.LayerNorm(self.d_model)
+
+        self.query_key = nn.Linear(self.d_model, key_width, bias=False)
+        self.candidate_key = nn.Sequential(
+            nn.Linear(self.d_model * 3, hidden),
+            nn.GELU(),
+            nn.Linear(hidden, key_width, bias=False),
+        )
+        self.relation = nn.Sequential(
+            nn.Linear(self.d_model * 4 + 1, hidden),
+            nn.GELU(),
+            nn.Linear(hidden, 1),
+        )
+        self.distance_temperature = nn.Parameter(torch.tensor(1.0))
+
+        self.value = nn.Sequential(
+            nn.Linear(self.d_model * 3, hidden),
+            nn.GELU(),
+            nn.Linear(hidden, self.d_model),
+        )
+        self.dispersion_projection = nn.Sequential(
+            nn.Linear(self.d_model, hidden),
+            nn.GELU(),
+            nn.Linear(hidden, self.d_model),
+        )
+        self.residual = nn.Sequential(
+            nn.Linear(self.d_model * 4, bottleneck),
+            nn.GELU(),
+            nn.Linear(bottleneck, self.d_model),
+        )
+        self.gate = nn.Sequential(
+            nn.Linear(self.d_model * 3, hidden),
+            nn.GELU(),
+            nn.Linear(hidden, 1),
+        )
+
+    def reset_adapter_parameters(self) -> None:
+        # Preserve Chronos at initialization while keeping all routing paths
+        # differentiable from the first update.
+        nn.init.normal_(self.residual[-1].weight, mean=0.0, std=3e-3)
+        nn.init.zeros_(self.residual[-1].bias)
+        nn.init.zeros_(self.gate[-1].weight)
+        nn.init.constant_(self.gate[-1].bias, -2.0)
+
+    def forward(
+        self,
+        sequence_output: torch.Tensor,
+        context: torch.Tensor,
+        retrieved_x: torch.Tensor,
+        retrieved_y: torch.Tensor,
+        distances: torch.Tensor,
+    ) -> tuple[torch.Tensor, torch.Tensor]:
+        if sequence_output.ndim != 3 or sequence_output.shape[1] != 1:
+            raise ValueError("CSEA sequence_output must have shape [B,1,D]")
+        if context.ndim != 2 or retrieved_x.ndim != 3 or retrieved_y.ndim != 3:
+            raise ValueError("CSEA inputs must be [B,S], [B,K,S], and [B,K,P]")
+        if retrieved_x.shape[:2] != retrieved_y.shape[:2]:
+            raise ValueError("CSEA history/future candidate dimensions do not match")
+        if distances.shape != retrieved_x.shape[:2]:
+            raise ValueError("CSEA distances must match the candidate dimensions")
+
+        query_patch = self.query_patch(
+            _temporal_patch_features(context, 16)
+        ).mean(dim=-2)
+        query = self.query_norm(
+            sequence_output[:, 0, :] + self.query_raw(context) + query_patch
+        )
+
+        history = self.candidate_norm(
+            self.history_raw(retrieved_x)
+            + self.history_patch(
+                _temporal_patch_features(retrieved_x, 16)
+            ).mean(dim=-2)
+        )
+        future = self.candidate_norm(
+            self.future_raw(retrieved_y)
+            + self.future_patch(
+                _temporal_patch_features(retrieved_y, 8)
+            ).mean(dim=-2)
+        )
+        transition = future - history
+        candidate = torch.cat((history, future, transition), dim=-1)
+        query_for_candidate = query[:, None, :].expand_as(history)
+
+        z_distance = distances.to(dtype=query.dtype)
+        z_distance = (
+            z_distance - z_distance.mean(dim=1, keepdim=True)
+        ) / z_distance.std(dim=1, keepdim=True, unbiased=False).clamp_min(1e-6)
+        kernel_query = F.normalize(self.query_key(query), dim=-1)
+        kernel_candidate = F.normalize(self.candidate_key(candidate), dim=-1)
+        kernel_score = torch.sum(
+            kernel_query[:, None, :] * kernel_candidate, dim=-1
+        )
+        relation_score = self.relation(
+            torch.cat((query_for_candidate, candidate, z_distance[..., None]), dim=-1)
+        ).squeeze(-1)
+        distance_weight = F.softplus(self.distance_temperature).clamp(0.05, 5.0)
+        logits = relation_score + kernel_score - distance_weight * z_distance
+        candidate_weights = torch.softmax(logits, dim=1)
+
+        candidate_values = self.value(candidate)
+        evidence = torch.sum(
+            candidate_weights[..., None] * candidate_values, dim=1
+        )
+        centered = candidate_values - evidence[:, None, :]
+        dispersion = torch.sum(
+            candidate_weights[..., None] * torch.square(centered), dim=1
+        )
+        dispersion = self.dispersion_projection(dispersion)
+
+        residual_input = torch.cat(
+            (query, evidence, dispersion, evidence - query), dim=-1
+        )
+        residual = self.residual(residual_input)
+        gate_input = torch.cat((query, evidence, dispersion), dim=-1)
+        gate = torch.sigmoid(self.gate(gate_input))
+        fused = sequence_output[:, 0, :] + gate * residual
+        return fused[:, None, :], candidate_weights[:, None, :]
