+            # BCSA to candidate futures before the learned set mixer.
+            self.bcsqm = BoundaryConditionedSetwiseQueryMixer(
+                d_model=config.d_model,
+                prediction_length=self.chronos_config.prediction_length,
+                latent_dim=384,
+                relation_hidden=128,
+                num_heads=6,
+            )
+
+        if self.augment == 'qcra_fair':
+            # QCRA keeps the query token as the sole anchor and reads the
