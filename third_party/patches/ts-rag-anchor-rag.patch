+            self.hidden_residual = nn.Sequential(
+                nn.Linear(self.d_model * 3, hidden),
+                nn.GELU(),
+                nn.Linear(hidden, self.d_model),
+            )
+
+    def reset_adapter_parameters(self) -> None:
+        # Start as a conservative evidence correction.  The tiny non-zero
+        # calibrator keeps gradient flow through the routing path from being
+        # identically blocked at step zero.
+        nn.init.normal_(self.calibrator[-1].weight, mean=0.0, std=1e-3)
+        nn.init.zeros_(self.calibrator[-1].bias)
+        nn.init.zeros_(self.gate[-1].weight)
+        nn.init.constant_(self.gate[-1].bias, -2.5)
+        if not self.forecast_space:
+            nn.init.normal_(self.hidden_residual[-1].weight, mean=0.0, std=1e-3)
+            nn.init.zeros_(self.hidden_residual[-1].bias)
+
+    def forward(
+        self,
+        sequence_output: torch.Tensor,
+        context: torch.Tensor,
+        retrieved_x: torch.Tensor,
+        retrieved_y: torch.Tensor,
+        distances: torch.Tensor,
+        query_loc: torch.Tensor,
+        query_scale: torch.Tensor,
+        context_raw: torch.Tensor,
+        retrieved_x_raw: torch.Tensor,
+        retrieved_y_raw: torch.Tensor,
+    ) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor]:
+        if sequence_output.ndim != 3 or sequence_output.shape[1] != 1:
+            raise ValueError("BFA sequence_output must have shape [B,1,D]")
+        if context.ndim != 2 or retrieved_x.ndim != 3 or retrieved_y.ndim != 3:
+            raise ValueError("BFA inputs must be [B,S], [B,K,S], and [B,H]")
+        if retrieved_x.shape[:2] != retrieved_y.shape[:2]:
+            raise ValueError("BFA history/future candidate dimensions do not match")
+        if distances.shape != retrieved_x.shape[:2]:
+            raise ValueError("BFA distances must match candidate dimensions")
+        if retrieved_x_raw.shape != retrieved_x.shape or retrieved_y_raw.shape != retrieved_y.shape:
+            raise ValueError("BFA raw and normalized candidate dimensions do not match")
+
+        # The transport is history-only and computed in float32 for stable
+        # medians.  It is then returned to the model dtype for mixed precision.
+        aligned_future_raw = _boundary_conditioned_shape_alignment(
+            context_raw.float(), retrieved_x_raw.float(), retrieved_y_raw.float()
+        )
+        loc = query_loc.to(aligned_future_raw.dtype).unsqueeze(1)
+        scale = query_scale.to(aligned_future_raw.dtype).clamp_min(1e-6).unsqueeze(1)
+        aligned_future = ((aligned_future_raw - loc) / scale).to(sequence_output.dtype)
+
+        query = self.query_norm(
+            sequence_output[:, 0, :]
+            + self.query_patch(
+                _temporal_patch_features(context, self.history_patch_size)
+            ).mean(dim=-2)
+        )
+        history = self.candidate_norm(
+            self.history_patch(
+                _temporal_patch_features(retrieved_x, self.history_patch_size)
+            ).mean(dim=-2)
+        )
+        future = self.candidate_norm(
+            self.future_patch(
+                _temporal_patch_features(retrieved_y, self.future_patch_size)
+            ).mean(dim=-2)
+        )
+        aligned_profile = self.candidate_norm(
+            self.aligned_patch(
+                _temporal_patch_features(aligned_future, self.future_patch_size)
+            ).mean(dim=-2)
+        )
+        transition = future - history
+
+        z_distance = distances.to(dtype=query.dtype)
+        z_distance = (
+            z_distance - z_distance.mean(dim=1, keepdim=True)
+        ) / z_distance.std(dim=1, keepdim=True, unbiased=False).clamp_min(1e-6)
+        query_for_candidate = query[:, None, :].expand_as(history)
+        relation_input = torch.cat(
+            (
+                query_for_candidate,
+                history,
+                future,
+                aligned_profile,
+                transition,
+                z_distance[..., None],
+            ),
+            dim=-1,
+        )
+        candidate_weights = torch.softmax(
+            self.relation(relation_input).squeeze(-1), dim=1
+        )
+
+        candidate_values = self.evidence_value(
+            torch.cat((aligned_profile, transition), dim=-1)
+        )
+        evidence = torch.sum(
+            candidate_weights[..., None] * candidate_values, dim=1
+        )
+        centered = candidate_values - evidence[:, None, :]
+        dispersion = torch.sum(
+            candidate_weights[..., None] * centered.square(), dim=1
+        )
+        dispersion = self.dispersion_projection(dispersion)
+
+        # Forecast-space candidate consensus, plus a small learned calibration
+        # residual.  The residual is bounded so a single candidate spike cannot
+        # cause an unbounded branch correction.
+        consensus = torch.sum(
+            candidate_weights[..., None] * aligned_future, dim=1
+        )
+        calibration_input = torch.cat((query, evidence, dispersion), dim=-1)
+        calibration = 0.25 * torch.tanh(self.calibrator(calibration_input))
+        consensus = consensus + calibration
+
+        gate = torch.sigmoid(self.gate(calibration_input))
+        # A parameter-free reliability safeguard: if the aligned candidate
+        # futures disagree in forecast space, the branch must retreat toward
+        # the frozen Chronos path.  The reciprocal form is bounded in (0, 1]
+        # and introduces no dataset-specific tuning constant.
+        forecast_dispersion = torch.sum(
+            candidate_weights[..., None]
+            * (aligned_future - consensus[:, None, :]).square(),
+            dim=(1, 2),
+        ) / float(self.prediction_length)
+        forecast_reliability = torch.reciprocal(1.0 + forecast_dispersion)
+        gate = gate * forecast_reliability[:, None]
+        if self.forecast_space:
+            fused = sequence_output[:, 0, :]
+        else:
+            # Hidden-residual mode never copies a candidate trajectory into the
+            # output head.  The learned evidence enters only through a bounded
+            # residual in Chronos' query representation; the outer MI+BCSA
+            # shell remains the forecast-space correction mechanism.
+            hidden_residual = 0.25 * torch.tanh(
+                self.hidden_residual(calibration_input)
+            )
+            fused = sequence_output[:, 0, :] + gate * hidden_residual
+        return fused[:, None, :], candidate_weights[:, None, :], consensus, gate
+
+
+class HorizonTransportFusionAdapter(nn.Module):
+    """Latent horizon-transport adapter for replacing the TS-RAG ARM.
+
+    HTFA is a new set operator rather than a copy of the official ARM or the
+    earlier BFA path.  It has three coupled, history-only views of each
+    retrieved pair:
+
+    * a latent cross-set route queries candidate histories and reads candidate
+      futures;
+    * a candidate self-mixer supplies a permutation-invariant context for the
+      route; and
+    * two causal forecast transports (endpoint and robust boundary shape) are
+      mixed per candidate before a bounded forecast-space residual is formed.
+
+    The transport choice is conditioned on the query/candidate relation, not
+    on the query future.  Both the hidden correction and the forecast
+    correction are scalar-gated and bounded, so a single pathological
+    retrieved trajectory cannot replace the frozen Chronos path wholesale.
+    """
+
+    def __init__(
+        self,
+        d_model: int,
+        prediction_length: int = 64,
+        latent_dim: int = 384,
+        hidden_dim: int = 192,
+        num_heads: int = 6,
+        use_hidden_residual: bool = True,
+    ) -> None:
+        super().__init__()
+        self.d_model = int(d_model)
+        self.prediction_length = int(prediction_length)
+        self.latent_dim = int(latent_dim)
+        self.hidden_dim = int(hidden_dim)
+        self.use_hidden_residual = bool(use_hidden_residual)
+        if self.latent_dim <= 0 or self.hidden_dim <= 0:
+            raise ValueError("HTFA latent and hidden dimensions must be positive")
+        if self.latent_dim % int(num_heads) != 0:
+            raise ValueError("HTFA latent dimension must be divisible by num_heads")
+
+        self.query_projection = nn.Linear(self.d_model, self.latent_dim)
+        self.query_patch = nn.Linear(5, self.latent_dim)
+        self.history_patch = nn.Linear(5, self.latent_dim)
+        self.future_patch = nn.Linear(5, self.latent_dim)
+        self.aligned_patch = nn.Linear(5, self.latent_dim)
+        self.query_norm = nn.LayerNorm(self.latent_dim)
+        self.candidate_norm = nn.LayerNorm(self.latent_dim)
+
+        self.cross_route = nn.MultiheadAttention(
+            embed_dim=self.latent_dim,
+            num_heads=int(num_heads),
+            batch_first=True,
+        )
+        self.candidate_mixer = nn.MultiheadAttention(
+            embed_dim=self.latent_dim,
+            num_heads=int(num_heads),
+            batch_first=True,
+        )
+        self.cross_ffn = nn.Sequential(
+            nn.Linear(self.latent_dim, self.latent_dim * 2),
+            nn.GELU(),
+            nn.Linear(self.latent_dim * 2, self.latent_dim),
+        )
+        self.candidate_ffn = nn.Sequential(
+            nn.Linear(self.latent_dim, self.latent_dim * 2),
+            nn.GELU(),
+            nn.Linear(self.latent_dim * 2, self.latent_dim),
+        )
+
+        # query + history + future + transition + distance
+        relation_width = self.latent_dim * 4 + 1
+        self.relation = nn.Sequential(
+            nn.Linear(relation_width, self.hidden_dim),
+            nn.GELU(),
+            nn.Linear(self.hidden_dim, 1),
+        )
+        self.transport_gate = nn.Sequential(
+            nn.Linear(relation_width, self.hidden_dim),
+            nn.GELU(),
+            nn.Linear(self.hidden_dim, 1),
+        )
+        self.evidence_projection = nn.Sequential(
+            nn.Linear(self.latent_dim * 2, self.latent_dim),
+            nn.GELU(),
+            nn.Linear(self.latent_dim, self.latent_dim),
+        )
+        self.hidden_projection = nn.Linear(self.latent_dim, self.d_model)
+        self.hidden_gate = nn.Sequential(
+            nn.Linear(self.latent_dim * 3, self.hidden_dim),
+            nn.GELU(),
+            nn.Linear(self.hidden_dim, 1),
+        )
+        self.calibrator = nn.Sequential(
+            nn.Linear(self.latent_dim * 3 + self.prediction_length, self.hidden_dim),
+            nn.GELU(),
+            nn.Linear(self.hidden_dim, self.prediction_length),
+        )
+        self.forecast_gate = nn.Sequential(
+            nn.Linear(self.latent_dim * 3 + self.prediction_length, self.hidden_dim),
+            nn.GELU(),
+            nn.Linear(self.hidden_dim, 1),
+        )
+
+    def reset_adapter_parameters(self) -> None:
+        """Initialize as a conservative, differentiable Chronos fallback."""
+
+        nn.init.normal_(self.hidden_projection.weight, mean=0.0, std=1e-3)
+        nn.init.zeros_(self.hidden_projection.bias)
+        nn.init.zeros_(self.cross_ffn[-1].weight)
+        nn.init.zeros_(self.cross_ffn[-1].bias)
+        nn.init.zeros_(self.candidate_ffn[-1].weight)
+        nn.init.zeros_(self.candidate_ffn[-1].bias)
+        nn.init.normal_(self.calibrator[-1].weight, mean=0.0, std=1e-3)
+        nn.init.zeros_(self.calibrator[-1].bias)
+        nn.init.zeros_(self.hidden_gate[-1].weight)
+        nn.init.constant_(self.hidden_gate[-1].bias, -2.5)
+        nn.init.zeros_(self.forecast_gate[-1].weight)
+        nn.init.constant_(self.forecast_gate[-1].bias, -2.5)
+
+    def forward(
+        self,
+        sequence_output: torch.Tensor,
+        context: torch.Tensor,
+        retrieved_x: torch.Tensor,
+        retrieved_y: torch.Tensor,
+        distances: torch.Tensor,
+        query_loc: torch.Tensor,
+        query_scale: torch.Tensor,
+        context_raw: torch.Tensor,
+        retrieved_x_raw: torch.Tensor,
+        retrieved_y_raw: torch.Tensor,
+    ) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor]:
+        if sequence_output.ndim != 3 or sequence_output.shape[1] != 1:
+            raise ValueError("HTFA sequence_output must have shape [B,1,D]")
+        if context.ndim != 2 or retrieved_x.ndim != 3 or retrieved_y.ndim != 3:
+            raise ValueError("HTFA inputs must be [B,S], [B,K,S], and [B,K,H]")
+        if retrieved_x.shape[:2] != retrieved_y.shape[:2]:
+            raise ValueError("HTFA history/future candidate dimensions do not match")
+        if distances.shape != retrieved_x.shape[:2]:
+            raise ValueError("HTFA distances must match candidate dimensions")
+        if retrieved_x_raw.shape != retrieved_x.shape or retrieved_y_raw.shape != retrieved_y.shape:
+            raise ValueError("HTFA raw and normalized candidate dimensions do not match")
+
+        query = self.query_norm(
+            self.query_projection(sequence_output[:, 0, :])
+            + self.query_patch(
+                _temporal_patch_features(context, 16)
+            ).mean(dim=-2)
+        )
+        history = self.candidate_norm(
+            self.history_patch(
+                _temporal_patch_features(retrieved_x, 16)
+            ).mean(dim=-2)
+        )
+        future = self.candidate_norm(
+            self.future_patch(
+                _temporal_patch_features(retrieved_y, 8)
+            ).mean(dim=-2)
+        )
+        aligned_raw = _boundary_conditioned_shape_alignment(
+            context_raw.float(), retrieved_x_raw.float(), retrieved_y_raw.float()
+        )
+        # HTFA deliberately narrows the BCSA scale range.  This is a
+        # parameter-free robustification of the transport, not a test-set
+        # calibration constant.
+        query_delta = context_raw.float()[:, 1:] - context_raw.float()[:, :-1]
+        candidate_delta = retrieved_x_raw.float()[..., 1:] - retrieved_x_raw.float()[..., :-1]
+        query_median = query_delta.median(dim=1).values
+        candidate_median = candidate_delta.median(dim=2).values
+        query_mad = (query_delta - query_median[:, None]).abs().median(dim=1).values
+        candidate_mad = (
+            (candidate_delta - candidate_median[..., None]).abs()
+            .median(dim=2)
+            .values
+        )
+        robust_ratio = torch.sqrt(
+            (query_mad[:, None] + 1e-6) / (candidate_mad + 1e-6)
+        ).clamp(0.25, 4.0)
+        robust_aligned_raw = context_raw[:, None, -1:] + robust_ratio[..., None] * (
+            retrieved_y_raw - retrieved_x_raw[..., -1:]
+        )
+        loc = query_loc.to(aligned_raw.dtype).unsqueeze(1)
+        scale = query_scale.to(aligned_raw.dtype).clamp_min(1e-6).unsqueeze(1)
+        aligned = ((aligned_raw - loc) / scale).to(sequence_output.dtype)
+        robust_aligned = ((robust_aligned_raw - loc) / scale).to(sequence_output.dtype)
+
+        transition = future - history
+        z_distance = distances.to(dtype=query.dtype)
+        z_distance = (
+            z_distance - z_distance.mean(dim=1, keepdim=True)
+        ) / z_distance.std(dim=1, keepdim=True, unbiased=False).clamp_min(1e-6)
+        query_for_candidate = query[:, None, :].expand_as(history)
+        relation_input = torch.cat(
+            (query_for_candidate, history, future, transition, z_distance[..., None]),
+            dim=-1,
+        )
+        relation_logits = self.relation(relation_input).squeeze(-1)
+        relation_weights = torch.softmax(relation_logits, dim=1)
+
+        # Cross-set latent route: query history asks for future evidence; the
+        # relation prior makes the result invariant to candidate ordering.
+        cross_query = query[:, None, :]
+        routed, _ = self.cross_route(cross_query, history, future, need_weights=False)
+        routed = routed + self.cross_ffn(routed)
+        mixed_future, _ = self.candidate_mixer(future, future, future, need_weights=False)
+        mixed_future = future + self.candidate_ffn(mixed_future)
+        mixed_summary = torch.sum(
+            relation_weights[..., None] * mixed_future, dim=1
+        )
+        routed_summary = routed[:, 0, :]
+        evidence = self.evidence_projection(
+            torch.cat((routed_summary, mixed_summary), dim=-1)
+        )
+
+        # Candidate-specific transport interpolation is learned from
+        # history-side relations only.  It can select endpoint transport when
+        # shape scaling is unstable and robust BCSA when dynamics transfer is
+        # informative.
+        transport = torch.sigmoid(self.transport_gate(relation_input))
+        transported = (
+            transport * aligned
+            + (1.0 - transport) * robust_aligned
+        )
+        consensus = torch.sum(
+            relation_weights[..., None] * transported, dim=1
+        )
+        calibration_input = torch.cat(
+            (query, evidence, mixed_summary, consensus), dim=-1
+        )
+        calibration = 0.20 * torch.tanh(self.calibrator(calibration_input))
+        consensus = consensus + calibration
+
+        if self.use_hidden_residual:
+            hidden_features = torch.cat((query, evidence, mixed_summary), dim=-1)
+            hidden_gate = torch.sigmoid(self.hidden_gate(hidden_features))
+            hidden_delta = self.hidden_projection(evidence)
+            fused_hidden = sequence_output[:, 0, :] + hidden_gate * hidden_delta
+        else:
+            # Forecast-only HTFA keeps the checkpoint schema but removes the
+            # hidden-state residual path, isolating forecast-space transport.
+            fused_hidden = sequence_output[:, 0, :]
+
+        forecast_gate = torch.sigmoid(self.forecast_gate(calibration_input))
+        forecast_dispersion = torch.sum(
+            relation_weights[..., None]
+            * (transported - consensus[:, None, :]).square(),
+            dim=(1, 2),
+        ) / float(self.prediction_length)
+        reliability = torch.reciprocal(1.0 + forecast_dispersion)
+        forecast_gate = forecast_gate * reliability[:, None]
+        return fused_hidden[:, None, :], relation_weights[:, None, :], consensus, forecast_gate
+
+
+class CrossHorizonSelectiveFusionAdapter(nn.Module):
+    """Cross-horizon selective fusion adapter for replacing TS-RAG ARM.
+
+    CHSFA combines three distinct signals without copying the official ARM:
+
+    * query-to-history cross-attention selects retrieved futures using only
+      the query representation and retrieved histories;
+    * candidate self-attention builds a query-independent context over the
+      retrieved future set; and
+    * a history-conditioned transport maps each candidate future to the query
+      boundary before a bounded forecast-space correction is admitted.
+
+    The query path is never replaced in hidden space.  This keeps the frozen
+    Chronos forecast as the anchor while allowing the new module to learn a
+    useful, horizon-aware retrieval correction.  The teacher may be used by
+    ``pretrain.py`` for distillation, but no official ARM parameter is
+    included in this module or loaded at inference.
+    """
+
+    def __init__(
+        self,
+        d_model: int,
+        prediction_length: int = 64,
+        latent_dim: int = 384,
+        hidden_dim: int = 192,
+        num_heads: int = 6,
+        include_aligned_relation: bool = False,
+        horizon_wise_gate: bool = False,
+    ) -> None:
+        super().__init__()
+        self.d_model = int(d_model)
+        self.prediction_length = int(prediction_length)
+        self.latent_dim = int(latent_dim)
+        self.hidden_dim = int(hidden_dim)
+        self.include_aligned_relation = bool(include_aligned_relation)
+        self.horizon_wise_gate = bool(horizon_wise_gate)
+        if self.latent_dim <= 0 or self.hidden_dim <= 0:
+            raise ValueError("CHSFA latent and hidden dimensions must be positive")
+        if self.latent_dim % int(num_heads) != 0:
+            raise ValueError("CHSFA latent dimension must be divisible by num_heads")
+
+        self.query_projection = nn.Linear(self.d_model, self.latent_dim)
+        self.query_patch = nn.Linear(5, self.latent_dim)
+        self.history_patch = nn.Linear(5, self.latent_dim)
+        self.future_patch = nn.Linear(5, self.latent_dim)
+        if self.include_aligned_relation:
+            self.aligned_patch = nn.Linear(5, self.latent_dim)
+        self.query_norm = nn.LayerNorm(self.latent_dim)
+        self.history_norm = nn.LayerNorm(self.latent_dim)
+        self.future_norm = nn.LayerNorm(self.latent_dim)
+
+        self.cross_attention = nn.MultiheadAttention(
+            embed_dim=self.latent_dim,
+            num_heads=int(num_heads),
+            batch_first=True,
+        )
+        self.future_self_attention = nn.MultiheadAttention(
+            embed_dim=self.latent_dim,
+            num_heads=int(num_heads),
+            batch_first=True,
+        )
+        self.cross_ffn = nn.Sequential(
+            nn.Linear(self.latent_dim, self.latent_dim * 2),
+            nn.GELU(),
+            nn.Linear(self.latent_dim * 2, self.latent_dim),
+        )
+        self.self_ffn = nn.Sequential(
+            nn.Linear(self.latent_dim, self.latent_dim * 2),
+            nn.GELU(),
+            nn.Linear(self.latent_dim * 2, self.latent_dim),
+        )
+
+        # query + history + future + [aligned future] + transport delta + distance
+        relation_width = self.latent_dim * (5 if self.include_aligned_relation else 4) + 1
+        self.relation = nn.Sequential(
+            nn.Linear(relation_width, self.hidden_dim),
+            nn.GELU(),
+            nn.Linear(self.hidden_dim, 1),
+        )
+        self.transport_gate = nn.Sequential(
+            nn.Linear(relation_width, self.hidden_dim),
+            nn.GELU(),
+            nn.Linear(self.hidden_dim, 1),
+        )
+        self.residual_head = nn.Sequential(
+            nn.Linear(self.latent_dim * 3 + self.prediction_length, self.hidden_dim),
+            nn.GELU(),
+            nn.Linear(self.hidden_dim, self.prediction_length),
+        )
+        self.forecast_gate = nn.Sequential(
+            nn.Linear(self.latent_dim * 3 + self.prediction_length, self.hidden_dim),
+            nn.GELU(),
+            nn.Linear(
+                self.hidden_dim,
+                self.prediction_length if self.horizon_wise_gate else 1,
+            ),
+        )
+
+    def reset_adapter_parameters(self) -> None:
+        # Near-zero forecast correction gives a stable Chronos anchor while
+        # retaining non-zero gradients through the new routing path.
+        nn.init.normal_(self.residual_head[-1].weight, mean=0.0, std=1e-3)
+        nn.init.zeros_(self.residual_head[-1].bias)
+        nn.init.zeros_(self.forecast_gate[-1].weight)
+        nn.init.constant_(self.forecast_gate[-1].bias, -2.5)
+
+    def forward(
+        self,
+        sequence_output: torch.Tensor,
+        context: torch.Tensor,
+        retrieved_x: torch.Tensor,
+        retrieved_y: torch.Tensor,
+        distances: torch.Tensor,
+        query_loc: torch.Tensor,
+        query_scale: torch.Tensor,
+        context_raw: torch.Tensor,
+        retrieved_x_raw: torch.Tensor,
+        retrieved_y_raw: torch.Tensor,
+    ) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor, torch.Tensor]:
+        if sequence_output.ndim != 3 or sequence_output.shape[1] != 1:
+            raise ValueError("CHSFA sequence_output must have shape [B,1,D]")
+        if context.ndim != 2 or retrieved_x.ndim != 3 or retrieved_y.ndim != 3:
+            raise ValueError("CHSFA inputs must be [B,S], [B,K,S], and [B,K,H]")
+        if retrieved_x.shape[:2] != retrieved_y.shape[:2]:
+            raise ValueError("CHSFA history/future candidate dimensions do not match")
+        if distances.shape != retrieved_x.shape[:2]:
+            raise ValueError("CHSFA distances must match candidate dimensions")
+        if retrieved_x_raw.shape != retrieved_x.shape or retrieved_y_raw.shape != retrieved_y.shape:
+            raise ValueError("CHSFA raw and normalized candidate dimensions do not match")
+
+        query = self.query_norm(
+            self.query_projection(sequence_output[:, 0, :])
+            + self.query_patch(_temporal_patch_features(context, 16)).mean(dim=-2)
+        )
+        history = self.history_norm(
+            self.history_patch(_temporal_patch_features(retrieved_x, 16)).mean(dim=-2)
+        )
+        future = self.future_norm(
+            self.future_patch(_temporal_patch_features(retrieved_y, 8)).mean(dim=-2)
+        )
+
+        # Equation (2)-style cross routing: histories are keys, futures are
+        # values.  The returned weights are query-conditioned and remain
+        # useful as an auditable candidate-selection signal.
+        cross, cross_weights = self.cross_attention(
+            query=query[:, None, :],
+            key=history,
+            value=future,
+            need_weights=True,
+            average_attn_weights=True,
+        )
+        cross = cross[:, 0, :] + self.cross_ffn(cross[:, 0, :])
+
+        # Query-independent candidate context, analogous to retrieval
+        # self-attention, but kept in a separate latent stream.
+        future_context, _ = self.future_self_attention(
+            future, future, future, need_weights=False
+        )
+        future_context = future + self.self_ffn(future_context)
+        set_summary = future_context.mean(dim=1)
+
+        query_delta = context_raw.float()[:, 1:] - context_raw.float()[:, :-1]
+        candidate_delta = retrieved_x_raw.float()[..., 1:] - retrieved_x_raw.float()[..., :-1]
+        query_median = query_delta.median(dim=1).values
+        candidate_median = candidate_delta.median(dim=2).values
+        query_mad = (query_delta - query_median[:, None]).abs().median(dim=1).values
+        candidate_mad = (
+            (candidate_delta - candidate_median[..., None]).abs().median(dim=2).values
+        )
+        robust_ratio = torch.sqrt(
+            (query_mad[:, None] + 1e-6) / (candidate_mad + 1e-6)
+        ).clamp(0.25, 4.0)
+        robust_transport = context_raw[:, None, -1:] + robust_ratio[..., None] * (
+            retrieved_y_raw - retrieved_x_raw[..., -1:]
+        )
+        standard_transport = _boundary_conditioned_shape_alignment(
+            context_raw.float(), retrieved_x_raw.float(), retrieved_y_raw.float()
+        )
+        loc = query_loc.to(standard_transport.dtype).reshape(query_loc.shape[0], -1)[:, :1]
+        scale = query_scale.to(standard_transport.dtype).clamp_min(1e-6)
+        scale = scale.reshape(query_scale.shape[0], -1)[:, :1]
+        standard_transport = ((standard_transport - loc[:, None]) / scale[:, None]).to(
+            sequence_output.dtype
+        )
+        robust_transport = ((robust_transport - loc[:, None]) / scale[:, None]).to(
+            sequence_output.dtype
+        )
+
+        transport_profile = standard_transport
+        if getattr(self, "transport_mode", "boundary") == "quantile":
+            # Quantile transport transfers a candidate's *relative future
+            # shape* into the query-history location/scale.  Clipping the
+            # shape before transfer prevents a single weather spike or
+            # near-constant candidate history from exploding the forecast.
+            query_center = context_raw.float().mean(dim=1, keepdim=True)
+            query_spread = context_raw.float().std(
+                dim=1, keepdim=True, unbiased=False
+            ).clamp_min(1e-6)
+            candidate_center = retrieved_x_raw.float().mean(dim=2, keepdim=True)
+            candidate_spread = retrieved_x_raw.float().std(
+                dim=2, keepdim=True, unbiased=False
+            ).clamp_min(1e-6)
+            candidate_shape = (
+                (retrieved_y_raw.float() - candidate_center) / candidate_spread
+            ).clamp(-5.0, 5.0)
+            quantile_transport_raw = (
+                query_center[:, None, :]
+                + query_spread[:, None, :] * candidate_shape
+            )
+            transport_profile = (
+                (quantile_transport_raw - loc[:, None]) / scale[:, None]
+            ).to(sequence_output.dtype)
+            if self.transport_clip is not None:
+                transport_profile = transport_profile.clamp(
+                    -self.transport_clip, self.transport_clip
+                )
+
+        aligned_profile = None
+        if self.include_aligned_relation:
+            aligned_profile = self.history_norm(
+                self.aligned_patch(
+                    _temporal_patch_features(transport_profile, 8)
+                ).mean(dim=-2)
+            )
+
+        z_distance = distances.to(dtype=query.dtype)
+        z_distance = (
+            z_distance - z_distance.mean(dim=1, keepdim=True)
+        ) / z_distance.std(dim=1, keepdim=True, unbiased=False).clamp_min(1e-6)
+        query_for_candidate = query[:, None, :].expand_as(history)
+        transport_delta = future - history
+        relation_parts = [query_for_candidate, history, future]
+        if aligned_profile is not None:
+            relation_parts.append(aligned_profile)
+        relation_parts.extend((transport_delta, z_distance[..., None]))
+        relation_input = torch.cat(relation_parts, dim=-1)
+        relation_logits = self.relation(relation_input).squeeze(-1)
+        # Cross-attention supplies the query/history relevance prior; the
+        # relation network adds distance and transition information.
+        cross_logits = torch.log(cross_weights[:, 0, :].clamp_min(1e-6))
+        candidate_weights = torch.softmax(cross_logits + relation_logits, dim=1)
+
+        if getattr(self, "transport_mode", "boundary") == "quantile":
+            transported = transport_profile
+        else:
+            transport_selector = torch.sigmoid(self.transport_gate(relation_input))
+            transported = (
+                transport_selector * standard_transport
+                + (1.0 - transport_selector) * robust_transport
+            )
+        aggregation_mode = getattr(self, "aggregation_mode", "weighted")
+        if aggregation_mode == "median":
+            consensus = transported.median(dim=1).values
+        elif aggregation_mode == "trimmed" and transported.shape[1] > 2:
+            consensus = torch.sort(transported, dim=1).values[:, 1:-1].mean(dim=1)
+        else:
+            consensus = torch.sum(candidate_weights[..., None] * transported, dim=1)
+        fusion_input = torch.cat((query, cross, set_summary, consensus), dim=-1)
+        residual = 0.15 * torch.tanh(self.residual_head(fusion_input))
+        gate = torch.sigmoid(self.forecast_gate(fusion_input))
+        dispersion = torch.sum(
+            candidate_weights[..., None] * (transported - consensus[:, None, :]).square(),
+            dim=(1, 2),
+        ) / float(self.prediction_length)
+        reliability = torch.reciprocal(1.0 + dispersion)
+        gate = gate * reliability[:, None]
+        # CHSFA is forecast-space only: the hidden Chronos anchor is retained.
+        return (
+            sequence_output,
+            candidate_weights[:, None, :],
+            consensus + residual,
+            gate,
+        )
+
+
+class HorizonCrossTransportAdapter(CrossHorizonSelectiveFusionAdapter):
+    """Horizon-cross transport adapter (HCTA), a second ARM replacement.
+
+    HCTA keeps CHSFA's query-to-history cross-attention and future-set
+    self-attention, but makes two structural changes: the relation router also
+    sees the history-only boundary-transport profile, and the forecast gate is
+    predicted independently for every future horizon.  The query future is
+    never used by either path, so the extra selectivity remains causal and
+    auditable.  It is intentionally implemented as a distinct adapter mode so
+    its checkpoint and ablation are not conflated with CHSFA.
+    """
+
+    def __init__(
+        self,
+        d_model: int,
+        prediction_length: int = 64,
+        latent_dim: int = 384,
+        hidden_dim: int = 192,
+        num_heads: int = 6,
+        transport_mode: str = "boundary",
+        aggregation_mode: str = "weighted",
+    ) -> None:
+        super().__init__(
+            d_model=d_model,
+            prediction_length=prediction_length,
+            latent_dim=latent_dim,
+            hidden_dim=hidden_dim,
+            num_heads=num_heads,
+            include_aligned_relation=True,
+            horizon_wise_gate=True,
+        )
+        if transport_mode not in {"boundary", "quantile"}:
+            raise ValueError(f"unknown HCTA transport mode: {transport_mode!r}")
+        if aggregation_mode not in {"weighted", "median", "trimmed"}:
+            raise ValueError(f"unknown HCTA aggregation mode: {aggregation_mode!r}")
+        self.transport_mode = str(transport_mode)
+        self.aggregation_mode = str(aggregation_mode)
+
+
+class RobustQuantileConsensusAdapter(HorizonCrossTransportAdapter):
+    """Robust quantile-consensus ARM replacement (RQCA).
+
+    RQCA is a new transport rule rather than a copy of the official ARM or
+    Cross-RAG.  It maps every retrieved future through the candidate-history
+    distribution into the query-history distribution, clips the transferred
+    shape to a robust range, and aggregates the candidate trajectories with a
+    coordinate-wise median.  The query future is never used by this path.
+
+    This is intentionally a subclass only to reuse the learned query/history
+    routing blocks; its transport and consensus operators are distinct and
+    are controlled by the two fixed mode flags below.
+    """
+
+    def __init__(
+        self,
+        d_model: int,
+        prediction_length: int = 64,
+        latent_dim: int = 384,
+        hidden_dim: int = 192,
+        num_heads: int = 6,
+        aggregation_mode: str = "median",
+    ) -> None:
+        super().__init__(
+            d_model=d_model,
+            prediction_length=prediction_length,
+            latent_dim=latent_dim,
+            hidden_dim=hidden_dim,
+            num_heads=num_heads,
+            transport_mode="quantile",
+            aggregation_mode=aggregation_mode,
+        )
+        # Optional inference-time safety bound for the transported normalized
+        # future.  The default keeps the original RQCA behavior; a finite
+        # value enables a validation-only robustification without changing the
+        # checkpoint schema or trainable parameter budget.
+        clip_value = os.environ.get("TSRAG_RQCA_TRANSPORT_CLIP", "")
+        self.transport_clip = (
+            float(clip_value) if clip_value.strip() else None
+        )
+
+
+class OutputEvidenceResidualAdapter(nn.Module):
+    """Output-space retrieval adapter with an explicit baseline-preserving path.
+
+    Unlike the official ARM, this module never replaces the Chronos query
+    representation.  It first builds a permutation-invariant evidence summary
+    from the retrieved histories/futures after history-only BCSA transport,
+    then predicts a bounded residual in Chronos' normalized forecast space.
+    The zero-initialized residual head makes the frozen zero-shot forecast an
+    exact initialization, while the scalar reliability gate prevents a noisy
+    candidate set from producing a large correction.
+    """
+
+    def __init__(
+        self,
+        d_model: int,
+        prediction_length: int = 64,
+        history_patch_size: int = 16,
+        future_patch_size: int = 8,
+        hidden_dim: int | None = None,
+    ) -> None:
+        super().__init__()
+        self.d_model = int(d_model)
+        self.prediction_length = int(prediction_length)
+        hidden = int(hidden_dim or max(self.d_model // 2, 32))
+        if hidden <= 0:
+            raise ValueError("OERA hidden_dim must be positive")
+
+        self.query_patch = nn.Linear(5, self.d_model)
+        self.history_patch = nn.Linear(5, self.d_model)
+        self.future_patch = nn.Linear(5, self.d_model)
+        self.query_norm = nn.LayerNorm(self.d_model)
+        self.candidate_norm = nn.LayerNorm(self.d_model)
+        self.relation = nn.Sequential(
+            nn.Linear(self.d_model * 4 + 1, hidden),
+            nn.GELU(),
+            nn.Linear(hidden, 1),
+        )
+        self.evidence = nn.Sequential(
+            nn.Linear(self.d_model * 2, self.d_model),
+            nn.GELU(),
+            nn.Linear(self.d_model, self.d_model),
+        )
+        self.dispersion = nn.Sequential(
+            nn.Linear(self.d_model, hidden),
+            nn.GELU(),
+            nn.Linear(hidden, self.d_model),
+        )
+        self.base_projection = nn.Sequential(
+            nn.Linear(self.prediction_length, self.d_model),
+            nn.LayerNorm(self.d_model),
+        )
+        self.consensus_projection = nn.Sequential(
+            nn.Linear(self.prediction_length, self.d_model),
+            nn.LayerNorm(self.d_model),
+        )
+        self.residual_head = nn.Sequential(
+            nn.Linear(self.d_model * 5, hidden),
+            nn.GELU(),
+            nn.Linear(hidden, self.prediction_length),
+        )
+        self.gate = nn.Sequential(
+            nn.Linear(self.d_model * 5, hidden),
+            nn.GELU(),
+            nn.Linear(hidden, 1),
+        )
+
+    def reset_adapter_parameters(self) -> None:
+        # Exact zero residual at initialization; the gate is conservative but
+        # trainable, so the adapter can expand only when evidence helps.
+        nn.init.zeros_(self.residual_head[-1].weight)
+        nn.init.zeros_(self.residual_head[-1].bias)
+        nn.init.zeros_(self.gate[-1].weight)
+        nn.init.constant_(self.gate[-1].bias, -2.5)
+
+    def forward(
+        self,
+        quantile_preds: torch.Tensor,
+        sequence_output: torch.Tensor,
+        context: torch.Tensor,
+        retrieved_x: torch.Tensor,
+        retrieved_y: torch.Tensor,
+        distances: torch.Tensor,
+        query_loc: torch.Tensor,
+        query_scale: torch.Tensor,
+        context_raw: torch.Tensor,
+        retrieved_x_raw: torch.Tensor,
+        retrieved_y_raw: torch.Tensor,
+    ) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+        if quantile_preds.ndim != 3:
+            raise ValueError("OERA quantile_preds must have shape [B,Q,H]")
+        if sequence_output.ndim != 3 or sequence_output.shape[1] != 1:
+            raise ValueError("OERA sequence_output must have shape [B,1,D]")
+        if retrieved_x.shape[:2] != retrieved_y.shape[:2]:
+            raise ValueError("OERA history/future candidate dimensions do not match")
+
+        aligned_raw = _boundary_conditioned_shape_alignment(
+            context_raw.float(), retrieved_x_raw.float(), retrieved_y_raw.float()
+        )
+        loc = query_loc.to(aligned_raw.dtype).unsqueeze(1)
+        scale = query_scale.to(aligned_raw.dtype).clamp_min(1e-6).unsqueeze(1)
+        aligned = ((aligned_raw - loc) / scale).to(quantile_preds.dtype)
+
+        query = self.query_norm(
+            sequence_output[:, 0, :]
+            + self.query_patch(_temporal_patch_features(context, 16)).mean(dim=-2)
+        )
+        history = self.candidate_norm(
+            self.history_patch(
+                _temporal_patch_features(retrieved_x, 16)
+            ).mean(dim=-2)
+        )
+        future = self.candidate_norm(
+            self.future_patch(
+                _temporal_patch_features(aligned, 8)
+            ).mean(dim=-2)
+        )
+        z_distance = distances.to(dtype=query.dtype)
+        z_distance = (
+            z_distance - z_distance.mean(dim=1, keepdim=True)
+        ) / z_distance.std(dim=1, keepdim=True, unbiased=False).clamp_min(1e-6)
+        relation_input = torch.cat(
+            (
+                query[:, None, :].expand_as(history),
+                history,
+                future,
+                future - history,
+                z_distance[..., None],
+            ),
+            dim=-1,
+        )
+        weights = torch.softmax(self.relation(relation_input).squeeze(-1), dim=1)
+        candidate_value = self.evidence(torch.cat((history, future), dim=-1))
+        evidence = torch.sum(weights[..., None] * candidate_value, dim=1)
+        centered = candidate_value - evidence[:, None, :]
+        dispersion = self.dispersion(
+            torch.sum(weights[..., None] * centered.square(), dim=1)
+        )
+        base = quantile_preds.mean(dim=1)
+        base_summary = self.base_projection(base)
+        consensus = torch.sum(weights[..., None] * aligned, dim=1)
+        consensus_summary = self.consensus_projection(consensus)
+        features = torch.cat(
+            (query, evidence, dispersion, base_summary, consensus_summary), dim=-1
+        )
+
+        # The residual is bounded in normalized forecast units; this avoids a
+        # dataset-specific output scale and keeps the Chronos forecast intact.
+        residual = 0.20 * torch.tanh(self.residual_head(features))
+        gate = torch.sigmoid(self.gate(features))
+        candidate_dispersion = torch.sum(
+            weights[..., None] * (aligned - torch.sum(weights[..., None] * aligned, dim=1)[:, None, :]).square(),
+            dim=(1, 2),
+        ) / float(self.prediction_length)
+        reliability = torch.reciprocal(1.0 + candidate_dispersion)
+        gate = gate * reliability[:, None]
+        fused = quantile_preds + gate[:, None, :] * residual[:, None, :]
+        return fused, weights[:, None, :], consensus
+
+
+class HorizonEvidenceCrossAttention(nn.Module):
+    """A compact horizon-preserving cross-attention ARM replacement.
+
+    Each retrieved future remains a single token whose value is produced from
+    the full prediction horizon.  The query token reads the candidate set with
+    one cross-attention operation; a small gated FFN then returns a residual to
+    the frozen Chronos representation.  This differs from the official ARM's
+    joint query/candidate self-attention and avoids compressing the future to a
+    scalar or pooled statistic before fusion.
+    """
+
+    def __init__(
+        self,
+        d_model: int,
+        prediction_length: int = 64,
+        hidden_dim: int = 192,
+        num_heads: int = 8,
+    ) -> None:
+        super().__init__()
+        self.d_model = int(d_model)
+        self.prediction_length = int(prediction_length)
+        self.future_projector = nn.Sequential(
+            nn.Linear(self.prediction_length, self.d_model),
+            nn.GELU(),
+            nn.Linear(self.d_model, self.d_model),
+        )
+        self.history_projector = nn.Linear(5, self.d_model)
+        self.query_norm = nn.LayerNorm(self.d_model)
+        self.candidate_norm = nn.LayerNorm(self.d_model)
+        self.cross_attention = nn.MultiheadAttention(
+            embed_dim=self.d_model,
+            num_heads=int(num_heads),
+            batch_first=True,
+        )
+        self.ffn = nn.Sequential(
+            nn.Linear(self.d_model, int(hidden_dim)),
+            nn.GELU(),
+            nn.Linear(int(hidden_dim), self.d_model),
+        )
+        self.gate = nn.Sequential(
+            nn.Linear(self.d_model * 2, int(hidden_dim)),
+            nn.GELU(),
+            nn.Linear(int(hidden_dim), 1),
+        )
+
+    def reset_adapter_parameters(self) -> None:
+        # Start close to the frozen Chronos query while preserving gradient
+        # flow through the cross-attention value path.
+        nn.init.zeros_(self.gate[-1].weight)
+        nn.init.constant_(self.gate[-1].bias, -2.5)
+
+    def forward(
+        self,
+        sequence_output: torch.Tensor,
+        context: torch.Tensor,
+        retrieved_x: torch.Tensor,
+        retrieved_y: torch.Tensor,
+        distances: torch.Tensor,
+        query_loc: torch.Tensor,
+        query_scale: torch.Tensor,
+        context_raw: torch.Tensor,
+        retrieved_x_raw: torch.Tensor,
+        retrieved_y_raw: torch.Tensor,
+        return_attention: bool = False,
+    ) -> tuple[torch.Tensor, torch.Tensor]:
+        if sequence_output.ndim != 3 or sequence_output.shape[1] != 1:
+            raise ValueError("HECA sequence_output must have shape [B,1,D]")
+        aligned_raw = _boundary_conditioned_shape_alignment(
+            context_raw.float(), retrieved_x_raw.float(), retrieved_y_raw.float()
+        )
+        loc = query_loc.to(aligned_raw.dtype).unsqueeze(1)
+        scale = query_scale.to(aligned_raw.dtype).clamp_min(1e-6).unsqueeze(1)
+        aligned = ((aligned_raw - loc) / scale).to(sequence_output.dtype)
+
+        query = self.query_norm(sequence_output)
+        future_tokens = self.future_projector(aligned)
+        history_tokens = self.history_projector(
+            _temporal_patch_features(retrieved_x, 16)
+        ).mean(dim=-2)
+        candidates = self.candidate_norm(future_tokens + history_tokens)
+        cross, attention = self.cross_attention(
+            query=query,
+            key=candidates,
+            value=candidates,
+            need_weights=True,
+            average_attn_weights=True,
+        )
+        context_update = cross + self.ffn(cross)
+        gate_input = torch.cat((query[:, 0, :], context_update[:, 0, :]), dim=-1)
+        gate = torch.sigmoid(self.gate(gate_input))
+        # Candidate disagreement acts only as a bounded reliability factor.
+        candidate_attention = attention[:, 0, :]
+        attended = torch.sum(candidate_attention[..., None] * aligned, dim=1)
+        dispersion = torch.sum(
+            candidate_attention[..., None] * (aligned - attended[:, None, :]).square(),
+            dim=(1, 2),
+        ) / float(self.prediction_length)
+        reliability = torch.reciprocal(1.0 + dispersion)
+        fused = sequence_output + gate[:, None, :] * reliability[:, None, None] * context_update
+        return fused, attention
+
+
+class ReliabilityGatedFutureAdapter(nn.Module):
+    """Forecast-space reliability-gated fusion for retrieved futures.
+
+    RGFA is a new ARM replacement built around a conservative principle:
+    retrieved futures can propose a bounded correction, but they cannot
+    overwrite the frozen Chronos forecast.  A query token cross-attends to
+    candidate history/future tokens, while a separate relation scorer forms a
+    permutation-invariant candidate consensus.  The residual amplitude is
+    bounded and multiplied by a history-only disagreement reliability factor.
+
+    Unlike the official ARM, this module does not concatenate retrieved
+    futures with the query token and does not modify the Chronos hidden state;
+    unlike a plain output blend, its candidate weights and admission gate are
+    learned from query--candidate relations.
+    """
+
+    def __init__(
+        self,
+        d_model: int,
+        prediction_length: int = 64,
+        latent_dim: int = 384,
+        hidden_dim: int = 192,
+        num_heads: int = 6,
+    ) -> None:
+        super().__init__()
+        self.d_model = int(d_model)
+        self.prediction_length = int(prediction_length)
+        self.latent_dim = int(latent_dim)
+        # Cross-dataset safety bound: this is part of RGFA's architecture,
+        # not a validation/test-tuned dataset parameter.
+        self.gate_cap = 0.25
+        if self.latent_dim % int(num_heads) != 0:
+            raise ValueError("RGFA latent dimension must be divisible by num_heads")
+        self.query_projection = nn.Linear(self.d_model, self.latent_dim)
+        self.query_patch = nn.Linear(5, self.latent_dim)
+        self.history_patch = nn.Linear(5, self.latent_dim)
+        self.future_projector = nn.Sequential(
+            nn.Linear(self.prediction_length, self.latent_dim),
+            nn.GELU(),
+            nn.Linear(self.latent_dim, self.latent_dim),
+        )
+        self.query_norm = nn.LayerNorm(self.latent_dim)
+        self.candidate_norm = nn.LayerNorm(self.latent_dim)
+        self.cross_attention = nn.MultiheadAttention(
+            embed_dim=self.latent_dim,
+            num_heads=int(num_heads),
+            batch_first=True,
+        )
+        self.cross_ffn = nn.Sequential(
+            nn.Linear(self.latent_dim, self.latent_dim),
+            nn.GELU(),
+            nn.Linear(self.latent_dim, self.latent_dim),
+        )
+
+        relation_width = self.latent_dim * 3 + 1
+        self.relation = nn.Sequential(
+            nn.Linear(relation_width, int(hidden_dim)),
+            nn.GELU(),
+            nn.Linear(int(hidden_dim), 1),
+        )
+        self.value_projection = nn.Sequential(
+            nn.Linear(self.latent_dim * 2, int(hidden_dim)),
+            nn.GELU(),
+            nn.Linear(int(hidden_dim), self.latent_dim),
+        )
+        self.dispersion_projection = nn.Linear(self.latent_dim, self.latent_dim)
+
+        feature_width = self.latent_dim * 3 + self.prediction_length
+        self.residual_head = nn.Sequential(
+            nn.Linear(feature_width, int(hidden_dim)),
+            nn.GELU(),
+            nn.Linear(int(hidden_dim), self.prediction_length),
+        )
+        self.gate = nn.Sequential(
+            nn.Linear(feature_width, int(hidden_dim)),
+            nn.GELU(),
+            nn.Linear(int(hidden_dim), 1),
+        )
+
+    def reset_adapter_parameters(self) -> None:
+        # Exact query-forecast fallback at initialization.  The residual head
+        # still receives gradients because the gate is finite and non-zero.
+        nn.init.zeros_(self.residual_head[-1].weight)
+        nn.init.zeros_(self.residual_head[-1].bias)
+        nn.init.zeros_(self.gate[-1].weight)
+        nn.init.constant_(self.gate[-1].bias, -2.5)
+
+    def forward(
+        self,
+        quantile_preds: torch.Tensor,
+        sequence_output: torch.Tensor,
+        context: torch.Tensor,
+        retrieved_x: torch.Tensor,
+        retrieved_y: torch.Tensor,
+        distances: torch.Tensor,
+        query_loc: torch.Tensor,
+        query_scale: torch.Tensor,
+        context_raw: torch.Tensor,
+        retrieved_x_raw: torch.Tensor,
+        retrieved_y_raw: torch.Tensor,
+    ) -> tuple[torch.Tensor, torch.Tensor, torch.Tensor]:
+        if quantile_preds.ndim != 3:
+            raise ValueError("RGFA quantile_preds must have shape [B,Q,H]")
+        if sequence_output.ndim != 3 or sequence_output.shape[1] != 1:
+            raise ValueError("RGFA sequence_output must have shape [B,1,D]")
+        if retrieved_x.shape[:2] != retrieved_y.shape[:2]:
+            raise ValueError("RGFA history/future candidate dimensions do not match")
+        if distances.shape != retrieved_x.shape[:2]:
+            raise ValueError("RGFA distances must match candidate dimensions")
+
+        aligned_raw = _boundary_conditioned_shape_alignment(
+            context_raw.float(), retrieved_x_raw.float(), retrieved_y_raw.float()
+        )
+        loc = query_loc.to(aligned_raw.dtype).reshape(query_loc.shape[0], -1)[:, :1]
+        scale = query_scale.to(aligned_raw.dtype).clamp_min(1e-6).reshape(query_scale.shape[0], -1)[:, :1]
+        loc = loc.unsqueeze(1)
+        scale = scale.unsqueeze(1)
+        aligned = ((aligned_raw - loc) / scale).to(quantile_preds.dtype)
+
+        query = self.query_norm(
+            self.query_projection(sequence_output[:, 0, :])
+            + self.query_patch(_temporal_patch_features(context, 16)).mean(dim=-2)
+        )
+        history = self.candidate_norm(
+            self.history_patch(
+                _temporal_patch_features(retrieved_x, 16)
+            ).mean(dim=-2)
+        )
+        future = self.candidate_norm(self.future_projector(aligned))
+
+        candidates = self.candidate_norm(history + future)
+        cross, attention = self.cross_attention(
+            query=query[:, None, :],
+            key=candidates,
+            value=candidates,
+            need_weights=True,
+            average_attn_weights=True,
+        )
+        attended = cross[:, 0, :] + self.cross_ffn(cross[:, 0, :])
+
+        z_distance = distances.to(dtype=query.dtype)
+        z_distance = (
+            z_distance - z_distance.mean(dim=1, keepdim=True)
+        ) / z_distance.std(dim=1, keepdim=True, unbiased=False).clamp_min(1e-6)
+        relation_input = torch.cat(
+            (
+                query[:, None, :].expand_as(history),
+                history,
+                future,
+                z_distance[..., None],
+            ),
+            dim=-1,
+        )
+        weights = torch.softmax(self.relation(relation_input).squeeze(-1), dim=1)
+
+        candidate_values = self.value_projection(torch.cat((history, future), dim=-1))
+        evidence = torch.sum(weights[..., None] * candidate_values, dim=1)
+        centered = candidate_values - evidence[:, None, :]
+        dispersion = torch.sum(weights[..., None] * centered.square(), dim=1)
+        dispersion = self.dispersion_projection(dispersion)
+
+        consensus = torch.sum(weights[..., None] * aligned, dim=1)
+        features = torch.cat((query, attended + evidence, dispersion, consensus), dim=-1)
+        residual = 0.15 * torch.tanh(self.residual_head(features))
+        learned_gate = torch.sigmoid(self.gate(features))
+        forecast_dispersion = torch.sum(
+            weights[..., None] * (aligned - consensus[:, None, :]).square(),
+            dim=(1, 2),
+        ) / float(self.prediction_length)
+        reliability = torch.reciprocal(1.0 + forecast_dispersion)
+        gate = self.gate_cap * learned_gate * reliability[:, None]
+        fused = quantile_preds + gate[:, None, :] * residual[:, None, :]
+        return fused, attention, consensus
+
+
+class RelationAwareExpertMixer(nn.Module):
+    """Relation-aware hidden mixer using raw retrieved futures.
+
+    RAEM replaces the official ARM with two explicitly separated operations:
+    joint token contextualization and history-only expert allocation.  The
+    joint attention sees the query token and the candidate future tokens, but
+    the final candidate weights are produced from query history, candidate
+    history, candidate future representation and distance.  A zero-initialized
+    bottleneck residual preserves the frozen Chronos anchor at initialization.
+
+    BCSA is intentionally not applied inside this branch.  It remains an
+    outer forecast-consensus operation, so the learned anchor sees the same
+    raw retrieved future semantics used by the official pretraining protocol.
+    """
+
+    def __init__(
+        self,
+        d_model: int,
+        prediction_length: int = 64,
+        hidden_dim: int = 96,
+        residual_dim: int = 256,
+        num_heads: int = 8,
+    ) -> None:
+        super().__init__()
+        self.d_model = int(d_model)
+        self.prediction_length = int(prediction_length)
+        self.query_patch = nn.Linear(5, self.d_model)
+        self.history_patch = nn.Linear(5, self.d_model)
+        self.future_projector = nn.Sequential(
+            nn.Linear(self.prediction_length, self.d_model),
+            nn.GELU(),
+            nn.Linear(self.d_model, self.d_model),
+        )
+        self.query_norm = nn.LayerNorm(self.d_model)
+        self.candidate_norm = nn.LayerNorm(self.d_model)
+        self.joint_attention = nn.MultiheadAttention(
+            embed_dim=self.d_model,
+            num_heads=int(num_heads),
+            batch_first=True,
+        )
+        self.joint_ffn = nn.Sequential(
+            nn.Linear(self.d_model, int(residual_dim)),
+            nn.GELU(),
+            nn.Linear(int(residual_dim), self.d_model),
+        )
+
+        relation_width = self.d_model * 3 + 1
+        self.relation_gate = nn.Sequential(
+            nn.Linear(relation_width, int(hidden_dim)),
+            nn.GELU(),
+            nn.Linear(int(hidden_dim), 1),
+        )
+        self.query_gate = nn.Sequential(
+            nn.Linear(self.d_model, int(hidden_dim)),
+            nn.GELU(),
+            nn.Linear(int(hidden_dim), 1),
+        )
+        self.residual_projection = nn.Sequential(
+            nn.Linear(self.d_model, int(residual_dim)),
+            nn.GELU(),
+            nn.Linear(int(residual_dim), self.d_model),
+        )
+        self.residual_gate = nn.Sequential(
+            nn.Linear(self.d_model * 3, int(hidden_dim)),
+            nn.GELU(),
+            nn.Linear(int(hidden_dim), 1),
+        )
+
+    def reset_adapter_parameters(self) -> None:
+        # Preserve a strict Chronos fallback while retaining gradients through
+        # the residual projection from the first update.
+        nn.init.zeros_(self.residual_projection[-1].weight)
+        nn.init.zeros_(self.residual_projection[-1].bias)
+        nn.init.zeros_(self.residual_gate[-1].weight)
+        nn.init.constant_(self.residual_gate[-1].bias, -1.5)
+
+    def forward(
+        self,
+        sequence_output: torch.Tensor,
+        context: torch.Tensor,
+        retrieved_x: torch.Tensor,
+        retrieved_y: torch.Tensor,
+        distances: torch.Tensor,
+    ) -> tuple[torch.Tensor, torch.Tensor]:
+        if sequence_output.ndim != 3 or sequence_output.shape[1] != 1:
+            raise ValueError("RAEM sequence_output must have shape [B,1,D]")
+        if context.ndim != 2 or retrieved_x.ndim != 3 or retrieved_y.ndim != 3:
+            raise ValueError("RAEM inputs must be [B,S], [B,K,S], and [B,K,H]")
+        if retrieved_x.shape[:2] != retrieved_y.shape[:2]:
+            raise ValueError("RAEM history/future candidate dimensions do not match")
+        if distances.shape != retrieved_x.shape[:2]:
+            raise ValueError("RAEM distances must match candidate dimensions")
+
+        query = self.query_norm(
+            sequence_output[:, 0, :]
+            + self.query_patch(_temporal_patch_features(context, 16)).mean(dim=-2)
+        )
+        history = self.history_patch(
+            _temporal_patch_features(retrieved_x, 16)
+        ).mean(dim=-2)
+        future = self.future_projector(retrieved_y)
+        candidates = self.candidate_norm(history + future)
+
+        tokens = torch.cat((query[:, None, :], candidates), dim=1)
+        contextualized, attention = self.joint_attention(
+            tokens, tokens, tokens, need_weights=True, average_attn_weights=True
+        )
+        tokens = tokens + contextualized
+        tokens = tokens + self.joint_ffn(tokens)
+
+        z_distance = distances.to(dtype=query.dtype)
+        z_distance = (
+            z_distance - z_distance.mean(dim=1, keepdim=True)
+        ) / z_distance.std(dim=1, keepdim=True, unbiased=False).clamp_min(1e-6)
+        relation_input = torch.cat(
+            (
+                query[:, None, :].expand_as(history),
+                history,
+                future,
+                z_distance[..., None],
+            ),
+            dim=-1,
+        )
+        candidate_logits = self.relation_gate(relation_input).squeeze(-1)
+        query_logits = self.query_gate(query)
+        mixture_logits = torch.cat((query_logits, candidate_logits), dim=1)
+        mixture_weights = torch.softmax(mixture_logits, dim=1)
+        mixture = torch.sum(mixture_weights[..., None] * tokens, dim=1)
+
+        candidate_weights = mixture_weights[:, 1:]
+        candidate_mass = candidate_weights.sum(dim=1, keepdim=True).clamp_min(1e-6)
+        candidate_weights = candidate_weights / candidate_mass
+        candidate_center = torch.sum(
+            candidate_weights[..., None] * candidates, dim=1
+        )
+        candidate_dispersion = torch.sum(
+            candidate_weights[..., None]
+            * (candidates - candidate_center[:, None, :]).square(),
+            dim=(1, 2),
+        ) / float(candidates.shape[-1])
+        reliability = torch.reciprocal(1.0 + candidate_dispersion)
+
+        residual_features = torch.cat((query, mixture, candidate_center), dim=-1)
+        residual = 0.25 * torch.tanh(self.residual_projection(mixture))
+        gate = torch.sigmoid(self.residual_gate(residual_features))
+        gate = gate * reliability[:, None]
+        fused = sequence_output[:, 0, :] + gate * residual
+        return fused[:, None, :], attention[:, 0, :]
+
+
+class HorizonRelationalCrossAttentionAdapter(nn.Module):
+    """Horizon-relational cross-attention replacement for the ARM.
+
+    HRCA keeps the full retrieved horizon as a candidate token, but changes
+    the fusion topology: the query token reads the candidate set with one
+    cross-attention operation, while a separate history/distance relation
+    router supplies a permutation-invariant candidate pool.  It therefore
+    does not reproduce the official joint self-attention followed by a
+    token-wise MoE gate.  The candidate pool and the cross-attended context
+    are combined through a bounded hidden residual before Chronos' frozen
+    output projection.
+
+    The width of the relation router is intentionally small.  With the
+    Chronos-Bolt dimensions used here this keeps the trainable adapter below
+    the official ARM parameter budget while retaining the full 64-step
+    retrieved future instead of reducing it to a scalar statistic.
+    """
+
+    def __init__(
+        self,
+        d_model: int,
+        prediction_length: int = 64,
+        relation_hidden: int = 128,
+        num_heads: int = 8,
+    ) -> None:
+        super().__init__()
+        self.d_model = int(d_model)
+        self.prediction_length = int(prediction_length)
+        hidden = int(relation_hidden)
+        if hidden <= 0:
+            raise ValueError("HRCA relation_hidden must be positive")
+
+        self.future_projector = nn.Sequential(
+            nn.Linear(self.prediction_length, self.d_model),
+            nn.GELU(),
+            nn.Linear(self.d_model, self.d_model),
+        )
+        self.history_projector = nn.Linear(5, self.d_model)
+        self.query_norm = nn.LayerNorm(self.d_model)
+        self.candidate_norm = nn.LayerNorm(self.d_model)
+        self.cross_attention = nn.MultiheadAttention(
+            embed_dim=self.d_model,
+            num_heads=int(num_heads),
+            batch_first=True,
+        )
+        self.cross_ffn = nn.Sequential(
+            nn.Linear(self.d_model, self.d_model),
+            nn.GELU(),
+            nn.Linear(self.d_model, self.d_model),
+        )
+        self.relation = nn.Sequential(
+            nn.Linear(self.d_model * 3 + 1, hidden),
+            nn.GELU(),
+            nn.Linear(hidden, 1),
+        )
+        self.fusion_gate = nn.Sequential(
+            nn.Linear(self.d_model * 2, hidden),
+            nn.GELU(),
+            nn.Linear(hidden, 1),
+        )
+
+    def reset_adapter_parameters(self) -> None:
+        # A half-open gate lets the candidate path learn immediately, while
+        # the residual topology still retains the frozen query representation
+        # through the explicit skip connection below.
+        nn.init.zeros_(self.fusion_gate[-1].weight)
+        nn.init.constant_(self.fusion_gate[-1].bias, 0.0)
+
+    def forward(
+        self,
+        sequence_output: torch.Tensor,
+        context: torch.Tensor,
+        retrieved_x: torch.Tensor,
+        retrieved_y: torch.Tensor,
+        distances: torch.Tensor,
+    ) -> tuple[torch.Tensor, torch.Tensor]:
+        if sequence_output.ndim != 3 or sequence_output.shape[1] != 1:
+            raise ValueError("HRCA sequence_output must have shape [B,1,D]")
+        if context.ndim != 2 or retrieved_x.ndim != 3 or retrieved_y.ndim != 3:
+            raise ValueError("HRCA inputs must be [B,S], [B,K,S], and [B,K,H]")
+        if retrieved_x.shape[:2] != retrieved_y.shape[:2]:
+            raise ValueError("HRCA history/future candidate dimensions do not match")
+        if distances.shape != retrieved_x.shape[:2]:
+            raise ValueError("HRCA distances must match candidate dimensions")
+
+        query = self.query_norm(sequence_output[:, 0, :])
+        history = self.history_projector(
+            _temporal_patch_features(retrieved_x, 16)
+        ).mean(dim=-2)
+        future = self.future_projector(retrieved_y)
+        candidates = self.candidate_norm(history + future)
+
+        # Query-to-candidate attention reads the full candidate future tokens;
+        # candidate tokens never attend back to the query or to one another.
+        cross, attention = self.cross_attention(
+            query=query[:, None, :],
+            key=candidates,
+            value=candidates,
+            need_weights=True,
+            average_attn_weights=True,
+        )
+        cross = cross[:, 0, :]
+        cross = cross + self.cross_ffn(cross)
+
+        z_distance = distances.to(dtype=query.dtype)
+        z_distance = (
+            z_distance - z_distance.mean(dim=1, keepdim=True)
+        ) / z_distance.std(dim=1, keepdim=True, unbiased=False).clamp_min(1e-6)
+        relation_input = torch.cat(
+            (
+                query[:, None, :].expand_as(history),
+                history,
+                future,
+                z_distance[..., None],
+            ),
+            dim=-1,
+        )
+        weights = torch.softmax(self.relation(relation_input).squeeze(-1), dim=1)
+        candidate_pool = torch.sum(weights[..., None] * candidates, dim=1)
+
+        update = cross + candidate_pool
+        gate = torch.sigmoid(
+            self.fusion_gate(torch.cat((query, update), dim=-1))
+        )
+        fused = sequence_output[:, 0, :] + gate * update
+        return fused[:, None, :], attention
+
+
+class BoundaryRelationalEvidenceAdapter(nn.Module):
+    """Boundary-relational evidence adapter replacing the TS-RAG ARM.
+
+    BREA differs from both the official joint-token ARM and HRCA.  It first
+    expresses every retrieved future in the query's boundary/scale space,
+    then performs query-conditioned set routing with an explicit bilinear
+    relation and a separate value path.  The routed evidence is converted to
+    a bounded residual in Chronos' hidden space, so the frozen query forecast
+    remains an exact protected path when the learned gate is small.
+    """
+
+    def __init__(
+        self,
+        d_model: int,
+        prediction_length: int = 64,
+        relation_hidden: int = 94,
+        relation_dim: int = 256,
+    ) -> None:
+        super().__init__()
+        self.d_model = int(d_model)
+        self.prediction_length = int(prediction_length)
+        hidden = int(relation_hidden)
+        rel_dim = int(relation_dim)
+        if hidden <= 0 or rel_dim <= 0:
+            raise ValueError("BREA dimensions must be positive")
+
+        self.query_patch_projection = nn.Linear(5, self.d_model)
+        self.history_projection = nn.Linear(5, self.d_model)
+        self.future_projection = nn.Sequential(
+            nn.Linear(self.prediction_length, self.d_model),
+            nn.GELU(),
+            nn.Linear(self.d_model, self.d_model),
+        )
+        self.boundary_projection = nn.Sequential(
+            nn.Linear(3, self.d_model),
+            nn.GELU(),
+            nn.Linear(self.d_model, self.d_model),
+        )
+        self.query_norm = nn.LayerNorm(self.d_model)
+        self.candidate_norm = nn.LayerNorm(self.d_model)
+        self.query_relation = nn.Linear(self.d_model, rel_dim, bias=False)
+        self.candidate_relation = nn.Linear(self.d_model, rel_dim, bias=False)
+        self.relation_score = nn.Sequential(
+            nn.Linear(self.d_model * 3 + 1, hidden),
+            nn.GELU(),
+            nn.Linear(hidden, 1),
+        )
+        self.value_network = nn.Sequential(
+            nn.Linear(self.d_model * 2, self.d_model),
+            nn.GELU(),
+            nn.Linear(self.d_model, self.d_model),
+        )
+        self.profile_projection = nn.Sequential(
+            nn.Linear(self.prediction_length, self.d_model),
+            nn.GELU(),
+            nn.Linear(self.d_model, self.d_model),
+        )
+        self.delta_network = nn.Sequential(
+            nn.Linear(self.d_model * 3, hidden),
+            nn.GELU(),
+            nn.Linear(hidden, self.d_model),
+        )
+        self.gate_network = nn.Sequential(
+            nn.Linear(self.d_model * 3, hidden),
+            nn.GELU(),
+            nn.Linear(hidden, 1),
+        )
+        self.residual_scale_logit = nn.Parameter(torch.tensor(-1.0986123))
+
+    def reset_adapter_parameters(self) -> None:
+        # Start as a conservative query-preserving adapter while keeping a
+        # nonzero residual path so all routing layers receive gradients.
+        nn.init.normal_(self.delta_network[-1].weight, mean=0.0, std=1e-3)
+        nn.init.zeros_(self.delta_network[-1].bias)
+        nn.init.zeros_(self.gate_network[-1].weight)
+        nn.init.constant_(self.gate_network[-1].bias, -1.5)
+        with torch.no_grad():
+            self.residual_scale_logit.fill_(-1.0986123)
+
+    def forward(
+        self,
+        sequence_output: torch.Tensor,
+        context: torch.Tensor,
+        retrieved_x: torch.Tensor,
+        retrieved_y: torch.Tensor,
+        distances: torch.Tensor,
+        context_raw: torch.Tensor,
+        retrieved_x_raw: torch.Tensor,
+        retrieved_y_raw: torch.Tensor,
+    ) -> tuple[torch.Tensor, torch.Tensor]:
+        if sequence_output.ndim != 3 or sequence_output.shape[1] != 1:
+            raise ValueError("BREA sequence_output must have shape [B,1,D]")
+        if context.ndim != 2 or retrieved_x.ndim != 3 or retrieved_y.ndim != 3:
+            raise ValueError("BREA normalized inputs have invalid dimensions")
+        if retrieved_x.shape[:2] != retrieved_y.shape[:2]:
+            raise ValueError("BREA history/future candidate dimensions do not match")
+        if distances.shape != retrieved_x.shape[:2]:
+            raise ValueError("BREA distances must match candidate dimensions")
+
+        # BCSA is computed only from histories and the query boundary.  The
+        # future target is never used here; this is safe for both training and
+        # inference and gives the adapter a query-comparable future space.
+        aligned_raw = _boundary_conditioned_shape_alignment(
+            context_raw, retrieved_x_raw, retrieved_y_raw
+        )
+        query_loc = torch.nan_to_num(context_raw.nanmean(dim=-1, keepdim=True), nan=0.0)
+        query_scale = torch.nan_to_num(
+            (context_raw - query_loc).square().nanmean(dim=-1, keepdim=True).sqrt(),
+            nan=1.0,
+        ).clamp_min(1e-5)
+        aligned_future = (aligned_raw - query_loc[:, None, :]) / query_scale[:, None, :]
+        aligned_future = aligned_future.to(dtype=sequence_output.dtype)
+
+        query_patch = self.query_patch_projection(
+            _temporal_patch_features(context, 16)
+        )
+        query = self.query_norm(
+            sequence_output[:, 0, :] + 0.25 * query_patch.mean(dim=-2)
+        )
+        history = self.history_projection(
+            _temporal_patch_features(retrieved_x, 16)
+        ).mean(dim=-2)
+        future = self.future_projection(aligned_future)
+
+        # Candidate boundary descriptors are query-space and permutation
+        # invariant: first/last aligned future values plus robust scale ratio.
+        query_delta = context_raw[..., 1:] - context_raw[..., :-1]
+        candidate_delta = retrieved_x_raw[..., 1:] - retrieved_x_raw[..., :-1]
+        query_mad = (
+            query_delta - query_delta.median(dim=-1, keepdim=True).values
+        ).abs().median(dim=-1).values.clamp_min(1e-6)
+        candidate_mad = (
+            candidate_delta
+            - candidate_delta.median(dim=-1, keepdim=True).values
+        ).abs().median(dim=-1).values.clamp_min(1e-6)
+        log_ratio = torch.log(query_mad[:, None] / candidate_mad).clamp(-4.0, 4.0)
+        boundary = torch.stack(
+            (aligned_future[..., 0], aligned_future[..., -1], log_ratio), dim=-1
+        )
+        candidate = self.candidate_norm(
+            history + future + self.boundary_projection(boundary)
+        )
+
+        distance_values = distances.to(dtype=query.dtype)
+        distance_values = (
+            distance_values - distance_values.mean(dim=1, keepdim=True)
+        ) / distance_values.std(dim=1, keepdim=True, unbiased=False).clamp_min(1e-6)
+        query_expanded = query[:, None, :].expand_as(candidate)
+        relation = self.relation_score(
+            torch.cat((query_expanded, candidate, candidate - query_expanded,
+                       distance_values[..., None]), dim=-1)
+        ).squeeze(-1)
+        bilinear = (
+            self.query_relation(query)[:, None, :]
+            * self.candidate_relation(candidate)
+        ).sum(dim=-1) / float(self.query_relation.out_features) ** 0.5
+        weights = torch.softmax(relation + bilinear, dim=1)
+
+        values = self.value_network(torch.cat((candidate, future), dim=-1))
+        evidence = torch.sum(weights[..., None] * values, dim=1)
+        profile = self.profile_projection(
+            torch.sum(weights[..., None] * aligned_future, dim=1)
+        )
+        fusion_input = torch.cat((query, evidence + profile, query - evidence - profile), dim=-1)
+        delta = torch.tanh(self.delta_network(fusion_input))
+        gate = torch.sigmoid(self.gate_network(fusion_input))
+        # A fixed, history-only reliability factor prevents a candidate set
+        # with internally inconsistent aligned futures from producing a large
+        # hidden correction.  The scale is measured in query-normalized
+        # units, so it is comparable across datasets without calibration.
+        candidate_spread = (
+            aligned_future - aligned_future.mean(dim=1, keepdim=True)
+        ).square().mean(dim=(1, 2)).sqrt()
+        candidate_reliability = torch.exp(-0.5 * candidate_spread.clamp(max=4.0))
+        gate = gate * candidate_reliability[:, None]
+        scale = 0.5 * torch.sigmoid(self.residual_scale_logit)
+        fused = sequence_output[:, 0, :] + scale * gate * delta
+        return fused[:, None, :], weights[:, None, :]
+
+
+class SetwiseQueryEvidenceAdapter(nn.Module):
+    """Setwise query-conditioned evidence mixer replacing the TS-RAG ARM.
+
+    SQEM separates two operations that are entangled in the official ARM:
+    candidate-set interaction and query-specific admission.  Retrieved
+    candidates first exchange information only within the set, after which a
+    query-conditioned relation router selects evidence.  The selected set
+    evidence enters Chronos through a bounded hidden residual; the query
+    representation is never replaced by an unbounded candidate average.
+    """
+
+    def __init__(
+        self,
+        d_model: int,
+        prediction_length: int = 64,
+        latent_dim: int = 384,
+        relation_hidden: int = 128,
+        num_heads: int = 6,
+    ) -> None:
+        super().__init__()
+        self.d_model = int(d_model)
+        self.prediction_length = int(prediction_length)
+        latent = int(latent_dim)
+        hidden = int(relation_hidden)
+        if latent % int(num_heads) != 0:
+            raise ValueError("SQEM latent_dim must be divisible by num_heads")
+
+        self.future_encoder = nn.Sequential(
+            nn.Linear(self.prediction_length, latent),
+            nn.GELU(),
+            nn.Linear(latent, latent),
+        )
+        self.history_encoder = nn.Linear(5, latent)
+        self.candidate_norm = nn.LayerNorm(latent)
+        self.candidate_attention = nn.MultiheadAttention(
+            embed_dim=latent,
+            num_heads=int(num_heads),
+            batch_first=True,
+        )
+        self.candidate_ffn = nn.Sequential(
+            nn.Linear(latent, latent * 2),
+            nn.GELU(),
+            nn.Linear(latent * 2, latent),
+        )
+        self.query_projection = nn.Linear(self.d_model, latent)
+        self.query_norm = nn.LayerNorm(latent)
+        self.relation_score = nn.Sequential(
+            nn.Linear(latent * 3 + 1, hidden),
+            nn.GELU(),
+            nn.Linear(hidden, 1),
+        )
+        self.value_projection = nn.Sequential(
+            nn.Linear(latent, self.d_model),
+            nn.GELU(),
+            nn.Linear(self.d_model, self.d_model),
+        )
+        self.profile_projection = nn.Sequential(
+            nn.Linear(self.prediction_length, latent),
+            nn.GELU(),
+            nn.Linear(latent, self.d_model),
+        )
+        self.delta_network = nn.Sequential(
+            nn.Linear(self.d_model * 3, hidden),
+            nn.GELU(),
+            nn.Linear(hidden, self.d_model),
+        )
+        self.gate_network = nn.Sequential(
+            nn.Linear(self.d_model * 3, hidden),
+            nn.GELU(),
+            nn.Linear(hidden, 1),
+        )
+        self.residual_scale_logit = nn.Parameter(torch.tensor(-1.0986123))
+
+    def reset_adapter_parameters(self) -> None:
+        nn.init.normal_(self.delta_network[-1].weight, mean=0.0, std=1e-3)
+        nn.init.zeros_(self.delta_network[-1].bias)
+        nn.init.zeros_(self.gate_network[-1].weight)
+        nn.init.constant_(self.gate_network[-1].bias, -1.5)
+        with torch.no_grad():
+            self.residual_scale_logit.fill_(-1.0986123)
+
+    def forward(
+        self,
+        sequence_output: torch.Tensor,
+        context: torch.Tensor,
+        retrieved_x: torch.Tensor,
+        retrieved_y: torch.Tensor,
+        distances: torch.Tensor,
+    ) -> tuple[torch.Tensor, torch.Tensor]:
+        if sequence_output.ndim != 3 or sequence_output.shape[1] != 1:
+            raise ValueError("SQEM sequence_output must have shape [B,1,D]")
+        if context.ndim != 2 or retrieved_x.ndim != 3 or retrieved_y.ndim != 3:
+            raise ValueError("SQEM inputs have invalid dimensions")
+        if retrieved_x.shape[:2] != retrieved_y.shape[:2]:
+            raise ValueError("SQEM history/future candidate dimensions do not match")
+        if distances.shape != retrieved_x.shape[:2]:
+            raise ValueError("SQEM distances must match candidate dimensions")
+
+        history = self.history_encoder(
+            _temporal_patch_features(retrieved_x, 16)
+        ).mean(dim=-2)
+        future = self.future_encoder(retrieved_y)
+        candidates = self.candidate_norm(history + future)
+        candidate_update, _ = self.candidate_attention(
+            candidates, candidates, candidates, need_weights=False
+        )
+        candidates = self.candidate_norm(candidates + candidate_update)
+        candidates = self.candidate_norm(candidates + self.candidate_ffn(candidates))
+
+        query = self.query_norm(self.query_projection(sequence_output[:, 0, :]))
+        distance_values = distances.to(dtype=query.dtype)
+        distance_values = (
+            distance_values - distance_values.mean(dim=1, keepdim=True)
+        ) / distance_values.std(dim=1, keepdim=True, unbiased=False).clamp_min(1e-6)
+        query_expanded = query[:, None, :].expand_as(candidates)
+        logits = self.relation_score(
+            torch.cat(
+                (query_expanded, candidates, candidates - query_expanded,
+                 distance_values[..., None]),
+                dim=-1,
+            )
+        ).squeeze(-1)
+        weights = torch.softmax(logits, dim=1)
+
+        evidence = torch.sum(
+            weights[..., None] * self.value_projection(candidates), dim=1
+        )
+        profile = self.profile_projection(
+            torch.sum(weights[..., None] * retrieved_y, dim=1)
+        )
+        evidence = evidence + profile
+        query_hidden = sequence_output[:, 0, :]
+        fusion_input = torch.cat((query_hidden, evidence, query_hidden - evidence), dim=-1)
+        delta = torch.tanh(self.delta_network(fusion_input))
+        gate = torch.sigmoid(self.gate_network(fusion_input))
+        scale = 0.5 * torch.sigmoid(self.residual_scale_logit)
+        fused = query_hidden + scale * gate * delta
+        return fused[:, None, :], weights[:, None, :]
+
+
+class BoundaryConditionedSetwiseQueryMixer(SetwiseQueryEvidenceAdapter):
+    """BCSA-aware setwise query mixer replacing the TS-RAG ARM.
+
+    BCSQM keeps SQEM's learned set interaction, but removes the candidate
+    level offset and volatility mismatch before encoding retrieved futures.
+    The alignment is deterministic and uses only query/candidate histories;
+    no extra trainable route or forecast-space parameter is introduced.
+    """
+
+    @staticmethod
+    def _mad_scale(values: torch.Tensor) -> torch.Tensor:
+        center = values.median(dim=-1, keepdim=True).values
+        return (values - center).abs().median(dim=-1).values.clamp_min(1e-6)
+
+    def forward(
+        self,
+        sequence_output: torch.Tensor,
+        context: torch.Tensor,
+        retrieved_x: torch.Tensor,
+        retrieved_y: torch.Tensor,
+        distances: torch.Tensor,
+    ) -> tuple[torch.Tensor, torch.Tensor]:
+        if context.ndim != 2 or retrieved_x.ndim != 3 or retrieved_y.ndim != 3:
+            raise ValueError("BCSQM inputs have invalid dimensions")
+        if retrieved_x.shape[:2] != retrieved_y.shape[:2]:
+            raise ValueError("BCSQM history/future candidate dimensions do not match")
+        query_scale = self._mad_scale(context[:, 1:] - context[:, :-1])
+        candidate_scale = self._mad_scale(
+            retrieved_x[:, :, 1:] - retrieved_x[:, :, :-1]
+        )
+        shape_scale = torch.exp(
+            0.5 * (
+                torch.log(query_scale[:, None])
+                - torch.log(candidate_scale)
+            ).clamp(-4.0, 4.0)
+        )
+        query_endpoint = context[:, -1, None]
+        candidate_endpoint = retrieved_x[:, :, -1, None]
+        aligned_future = query_endpoint[:, None, :] + shape_scale[..., None] * (
+            retrieved_y - candidate_endpoint
+        )
+        return super().forward(
+            sequence_output,
+            context,
+            retrieved_x,
+            aligned_future,
+            distances,
+        )
+
+
+class QueryCenteredRelationalAdapter(nn.Module):
+    """Query-centered cross-attention replacement for the TS-RAG ARM.
+
+    QCRA keeps the Chronos query as the anchor throughout the module.  Each
+    retrieved future is first projected in the same full-width latent space as
+    the Chronos hidden state; a single query token then reads the candidate set
+    through cross-attention.  A second, parameter-free relational router uses
+    query/candidate agreement and the supplied distance ranks to form a stable
+    evidence summary.  Only a bounded, gated residual is added to Chronos.
+
+    This differs from the official all-token ARM mixer in two ways: retrieved
+    candidates never overwrite the query token, and candidate admission is
+    explicitly query-centered rather than learned as an independent gate for
+    every token.
+    """
+
+    def __init__(
+        self,
+        d_model: int,
+        prediction_length: int = 64,
+        hidden_dim: int = 512,
+        num_heads: int = 8,
+    ) -> None:
+        super().__init__()
+        self.d_model = int(d_model)
+        self.prediction_length = int(prediction_length)
+        self.future_projector = nn.Sequential(
+            nn.Linear(self.prediction_length, self.d_model),
+            nn.ReLU(),
+            nn.Linear(self.d_model, self.d_model),
+        )
+        self.query_norm = nn.LayerNorm(self.d_model)
+        self.candidate_norm = nn.LayerNorm(self.d_model)
+        self.cross_attention = nn.MultiheadAttention(
+            embed_dim=self.d_model,
+            num_heads=int(num_heads),
+            batch_first=True,
+        )
+        self.residual_network = nn.Sequential(
+            nn.Linear(self.d_model, int(hidden_dim)),
+            nn.GELU(),
+            nn.Linear(int(hidden_dim), self.d_model),
+        )
+        # Query, cross-attention context, their difference, and two scalar
+        # history-only reliability descriptors.
+        self.admission_gate = nn.Linear(self.d_model * 3 + 2, 1)
+        self.residual_scale_logit = nn.Parameter(torch.tensor(-1.0986123))
+
+    def reset_adapter_parameters(self) -> None:
+        nn.init.normal_(self.residual_network[-1].weight, mean=0.0, std=1e-3)
+        nn.init.zeros_(self.residual_network[-1].bias)
+        nn.init.zeros_(self.admission_gate.weight)
+        nn.init.constant_(self.admission_gate.bias, -1.5)
+        with torch.no_grad():
+            self.residual_scale_logit.fill_(-1.0986123)
+
+    def forward(
+        self,
+        sequence_output: torch.Tensor,
+        context: torch.Tensor,
+        retrieved_x: torch.Tensor,
+        retrieved_y: torch.Tensor,
+        distances: torch.Tensor,
+    ) -> tuple[torch.Tensor, torch.Tensor]:
+        del context, retrieved_x
+        if sequence_output.ndim != 3 or sequence_output.shape[1] != 1:
+            raise ValueError("QCRA sequence_output must have shape [B,1,D]")
+        if retrieved_y.ndim != 3:
+            raise ValueError("QCRA retrieved_y must have shape [B,K,H]")
+        if distances.shape != retrieved_y.shape[:2]:
+            raise ValueError("QCRA distances must match candidate dimensions")
+
+        query_hidden = sequence_output[:, 0, :]
+        query = self.query_norm(query_hidden).unsqueeze(1)
+        candidates = self.candidate_norm(self.future_projector(retrieved_y))
+
+        cross, cross_weights = self.cross_attention(
+            query=query,
+            key=candidates,
+            value=candidates,
+            need_weights=True,
+            average_attn_weights=True,
+        )
+
+        # A separate parameter-free router makes the use of the supplied
+        # retrieval distance explicit while retaining a learned cross-attn
+        # path.  It is invariant to candidate ordering.
+        q = query[:, 0, :]
+        agreement = (candidates * q[:, None, :]).mean(dim=-1)
+        z_distance = distances.to(dtype=agreement.dtype)
+        z_distance = (
+            z_distance - z_distance.mean(dim=1, keepdim=True)
+        ) / z_distance.std(dim=1, keepdim=True, unbiased=False).clamp_min(1e-6)
+        relational_weights = torch.softmax(agreement - 0.15 * z_distance, dim=1)
+        evidence = torch.sum(relational_weights[..., None] * candidates, dim=1)
+        fused_context = cross[:, 0, :] + evidence
+
+        candidate_spread = (
+            candidates - candidates.mean(dim=1, keepdim=True)
+        ).square().mean(dim=(1, 2)).sqrt()
+        distance_spread = z_distance.square().mean(dim=1).sqrt()
+        gate_input = torch.cat(
+            (q, fused_context, q - fused_context,
+             candidate_spread[:, None], distance_spread[:, None]),
+            dim=-1,
+        )
+        gate = torch.sigmoid(self.admission_gate(gate_input))
+        delta = torch.tanh(self.residual_network(q + fused_context))
+        scale = 0.5 * torch.sigmoid(self.residual_scale_logit)
+        fused = query_hidden + scale * gate * delta
+
+        # Return the relational route for the same attention-audit interface
+        # used by the other replacement modules.
+        del cross_weights
+        return fused[:, None, :], relational_weights[:, None, :]
+
+
+class RelationalSetMixerAdapter(nn.Module):
+    """Set-level relational mixer replacing the TS-RAG ARM.
+
+    RSM keeps the full retrieved set visible during one joint self-attention
+    block, which preserves interactions among candidates that a single query
+    cross-attention read can miss.  It then performs an explicit, permutation-
+    invariant query-conditioned routing step and injects only a bounded
+    residual into the original Chronos query token.  The module is therefore
+    not the Official ARM's per-token gate-and-sum rule.
+    """
+
+    def __init__(
+        self,
+        d_model: int,
+        prediction_length: int = 64,
+        hidden_dim: int = 128,
+        num_heads: int = 8,
+    ) -> None:
+        super().__init__()
+        self.d_model = int(d_model)
+        self.prediction_length = int(prediction_length)
+        hidden = int(hidden_dim)
+        self.future_projector = nn.Sequential(
+            nn.Linear(self.prediction_length, self.d_model),
+            nn.ReLU(),
+            nn.Linear(self.d_model, self.d_model),
+        )
+        self.query_norm = nn.LayerNorm(self.d_model)
+        self.candidate_norm = nn.LayerNorm(self.d_model)
+        self.set_attention = nn.MultiheadAttention(
+            embed_dim=self.d_model,
+            num_heads=int(num_heads),
+            batch_first=True,
+        )
+        self.set_ffn = nn.Sequential(
+            nn.Linear(self.d_model, 512),
+            nn.GELU(),
+            nn.Linear(512, self.d_model),
+        )
+        self.relation = nn.Sequential(
+            nn.Linear(self.d_model * 3 + 1, hidden),
+            nn.GELU(),
+            nn.Linear(hidden, 1),
+        )
+        self.residual = nn.Sequential(
+            nn.Linear(self.d_model * 2, 128),
+            nn.GELU(),
+            nn.Linear(128, self.d_model),
+        )
+        self.gate = nn.Linear(self.d_model * 2 + 1, 1)
+        self.residual_scale_logit = nn.Parameter(torch.tensor(-1.0986123))
+
+    def reset_adapter_parameters(self) -> None:
+        nn.init.normal_(self.residual[-1].weight, mean=0.0, std=1e-3)
+        nn.init.zeros_(self.residual[-1].bias)
+        nn.init.zeros_(self.gate.weight)
+        nn.init.constant_(self.gate.bias, -1.5)
+        with torch.no_grad():
+            self.residual_scale_logit.fill_(-1.0986123)
+
+    def forward(
+        self,
+        sequence_output: torch.Tensor,
+        context: torch.Tensor,
+        retrieved_x: torch.Tensor,
+        retrieved_y: torch.Tensor,
+        distances: torch.Tensor,
+    ) -> tuple[torch.Tensor, torch.Tensor]:
+        del context, retrieved_x
+        if sequence_output.ndim != 3 or sequence_output.shape[1] != 1:
+            raise ValueError("RSM sequence_output must have shape [B,1,D]")
+        if retrieved_y.ndim != 3:
+            raise ValueError("RSM retrieved_y must have shape [B,K,H]")
+        if distances.shape != retrieved_y.shape[:2]:
+            raise ValueError("RSM distances must match candidate dimensions")
+
+        query_hidden = sequence_output[:, 0, :]
+        query = self.query_norm(query_hidden).unsqueeze(1)
+        candidates = self.candidate_norm(self.future_projector(retrieved_y))
+        tokens = torch.cat((query, candidates), dim=1)
+        set_update, _ = self.set_attention(tokens, tokens, tokens, need_weights=False)
+        tokens = tokens + set_update
+        tokens = tokens + self.set_ffn(tokens)
+
+        routed_query = tokens[:, :1, :]
+        routed_candidates = tokens[:, 1:, :]
+        z_distance = distances.to(dtype=routed_query.dtype)
+        z_distance = (
+            z_distance - z_distance.mean(dim=1, keepdim=True)
+        ) / z_distance.std(dim=1, keepdim=True, unbiased=False).clamp_min(1e-6)
+        query_expanded = routed_query.expand_as(routed_candidates)
+        logits = self.relation(
+            torch.cat(
+                (query_expanded, routed_candidates,
+                 routed_candidates - query_expanded, z_distance[..., None]),
+                dim=-1,
+            )
+        ).squeeze(-1)
+        weights = torch.softmax(logits, dim=1)
+        evidence = torch.sum(weights[..., None] * routed_candidates, dim=1)
+        candidate_spread = (
+            routed_candidates - routed_candidates.mean(dim=1, keepdim=True)
+        ).square().mean(dim=(1, 2)).sqrt()
+        gate_input = torch.cat(
+            (query_hidden, evidence, candidate_spread[:, None]), dim=-1
+        )
+        gate = torch.sigmoid(self.gate(gate_input))
+        delta = torch.tanh(self.residual(torch.cat((query_hidden, evidence), dim=-1)))
+        scale = 0.5 * torch.sigmoid(self.residual_scale_logit)
+        fused = query_hidden + scale * gate * delta
+        return fused[:, None, :], weights[:, None, :]
+
+
+class HistoryConditionedSetMixerAdapter(nn.Module):
+    """History-conditioned, anchor-preserving replacement for the ARM.
+
+    HCSM treats each retrieved item as a history/future pair.  The retrieved
+    history is used to condition the future token before a joint set-attention
+    block, while a distance-aware relation router decides which evidence is
+    allowed to perturb the query token.  The query remains the only output
+    anchor and the final update is explicitly gated and bounded.
+    """
+
+    def __init__(
+        self,
+        d_model: int,
+        context_length: int = 512,
+        prediction_length: int = 64,
+        hidden_dim: int = 128,
+        num_heads: int = 8,
+    ) -> None:
+        super().__init__()
+        self.d_model = int(d_model)
+        self.context_length = int(context_length)
+        self.prediction_length = int(prediction_length)
+        hidden = int(hidden_dim)
+        self.future_projector = nn.Sequential(
+            nn.Linear(self.prediction_length, self.d_model),
+            nn.GELU(),
+            nn.Linear(self.d_model, self.d_model),
+        )
+        # A narrow history branch adds pair identity without exceeding the
+        # official ARM parameter budget.
+        self.history_projector = nn.Sequential(
+            nn.Linear(self.context_length, 128),
+            nn.GELU(),
+            nn.Linear(128, self.d_model),
+        )
+        self.query_norm = nn.LayerNorm(self.d_model)
+        self.candidate_norm = nn.LayerNorm(self.d_model)
+        self.set_attention = nn.MultiheadAttention(
+            embed_dim=self.d_model,
+            num_heads=int(num_heads),
+            batch_first=True,
+        )
+        self.set_ffn = nn.Sequential(
+            nn.Linear(self.d_model, 512),
+            nn.GELU(),
+            nn.Linear(512, self.d_model),
+        )
+        self.relation = nn.Sequential(
+            nn.Linear(self.d_model * 3 + 1, hidden),
+            nn.GELU(),
+            nn.Linear(hidden, 1),
+        )
+        self.residual = nn.Sequential(
+            nn.Linear(self.d_model * 2, 128),
+            nn.GELU(),
+            nn.Linear(128, self.d_model),
+        )
+        self.gate = nn.Sequential(
+            nn.Linear(self.d_model * 2 + 3, 64),
+            nn.GELU(),
+            nn.Linear(64, 1),
+        )
+        self.history_scale_logit = nn.Parameter(torch.tensor(-1.0986123))
+        self.residual_scale_logit = nn.Parameter(torch.tensor(-1.0986123))
+
+    def reset_adapter_parameters(self) -> None:
+        nn.init.normal_(self.residual[-1].weight, mean=0.0, std=1e-3)
+        nn.init.zeros_(self.residual[-1].bias)
+        nn.init.zeros_(self.gate[-1].weight)
+        nn.init.constant_(self.gate[-1].bias, -2.0)
+        with torch.no_grad():
+            self.history_scale_logit.fill_(-1.0986123)
+            self.residual_scale_logit.fill_(-1.0986123)
+
+    def forward(
+        self,
+        sequence_output: torch.Tensor,
+        context: torch.Tensor,
+        retrieved_x: torch.Tensor,
+        retrieved_y: torch.Tensor,
+        distances: torch.Tensor,
+    ) -> tuple[torch.Tensor, torch.Tensor]:
+        del context
+        if sequence_output.ndim != 3 or sequence_output.shape[1] != 1:
+            raise ValueError("HCSM sequence_output must have shape [B,1,D]")
+        if retrieved_x.ndim != 3 or retrieved_y.ndim != 3:
+            raise ValueError("HCSM retrieved inputs must have shape [B,K,L]")
+        if retrieved_y.shape[:2] != retrieved_x.shape[:2]:
+            raise ValueError("HCSM retrieved history/future candidate counts differ")
+        if distances.shape != retrieved_y.shape[:2]:
+            raise ValueError("HCSM distances must match candidate dimensions")
+
+        query_hidden = sequence_output[:, 0, :]
+        query = self.query_norm(query_hidden).unsqueeze(1)
+        future_tokens = self.future_projector(retrieved_y)
+        history_tokens = self.history_projector(retrieved_x)
+        history_scale = 0.5 * torch.sigmoid(self.history_scale_logit)
+        candidates = self.candidate_norm(future_tokens + history_scale * torch.tanh(history_tokens))
+
+        tokens = torch.cat((query, candidates), dim=1)
+        set_update, _ = self.set_attention(tokens, tokens, tokens, need_weights=False)
+        tokens = tokens + set_update
+        tokens = tokens + self.set_ffn(tokens)
+        routed_query = tokens[:, :1, :]
+        routed_candidates = tokens[:, 1:, :]
+
+        z_distance = distances.to(dtype=routed_query.dtype)
+        z_distance = (z_distance - z_distance.mean(dim=1, keepdim=True)) / (
+            z_distance.std(dim=1, keepdim=True, unbiased=False).clamp_min(1e-6)
+        )
+        query_expanded = routed_query.expand_as(routed_candidates)
+        logits = self.relation(
+            torch.cat(
+                (query_expanded, routed_candidates,
+                 routed_candidates - query_expanded, z_distance[..., None]),
+                dim=-1,
+            )
+        ).squeeze(-1) - 0.25 * z_distance
+        weights = torch.softmax(logits, dim=1)
+        evidence = torch.sum(weights[..., None] * routed_candidates, dim=1)
+        spread = (routed_candidates - routed_candidates.mean(dim=1, keepdim=True)).square().mean(dim=(1, 2)).sqrt()
+        distance_abs = z_distance.abs().mean(dim=1)
+        distance_min = z_distance.min(dim=1).values
+        gate_input = torch.cat(
+            (query_hidden, evidence, spread[:, None], distance_abs[:, None], distance_min[:, None]),
+            dim=-1,
+        )
+        gate = torch.sigmoid(self.gate(gate_input))
+        delta = torch.tanh(self.residual(torch.cat((query_hidden, evidence), dim=-1)))
+        scale = 0.5 * torch.sigmoid(self.residual_scale_logit)
+        fused = query_hidden + scale * gate * delta
+        return fused[:, None, :], weights[:, None, :]
+
+
+class DistanceAwareQueryRouterAdapter(nn.Module):
+    """Distance-aware query router with a full token interaction block.
+
+    Unlike the official ARM, candidate admission is a joint relational
+    decision: the query, candidate state, candidate-query difference and the
+    normalized retrieval distance are scored together.  Unlike RSM/HCSM, the
+    routed token mixture is retained as a full-width residual rather than
+    compressed through a tanh bottleneck.  A query-conditioned route gate
+    controls how much of that residual reaches the frozen Chronos head.
+    """
+
+    def __init__(
+        self,
+        d_model: int,
+        prediction_length: int = 64,
+        hidden_dim: int = 128,
+        num_heads: int = 8,
+    ) -> None:
+        super().__init__()
+        self.d_model = int(d_model)
+        self.prediction_length = int(prediction_length)
+        hidden = int(hidden_dim)
+        self.future_projector = nn.Sequential(
+            nn.Linear(self.prediction_length, self.d_model),
+            nn.ReLU(),
+            nn.Linear(self.d_model, self.d_model),
+        )
+        self.set_attention = nn.MultiheadAttention(
+            embed_dim=self.d_model,
+            num_heads=int(num_heads),
+            batch_first=True,
+        )
+        self.set_ffn = nn.Sequential(
+            nn.Linear(self.d_model, 384),
+            nn.GELU(),
+            nn.Linear(384, self.d_model),
+        )
+        self.relation_score = nn.Sequential(
+            nn.Linear(self.d_model * 3 + 1, hidden),
+            nn.GELU(),
+            nn.Linear(hidden, 1),
+        )
+        self.query_score = nn.Sequential(
+            nn.Linear(self.d_model, hidden),
+            nn.GELU(),
+            nn.Linear(hidden, 1),
+        )
+        self.route_gate = nn.Sequential(
+            nn.Linear(self.d_model * 2 + 2, hidden),
+            nn.GELU(),
+            nn.Linear(hidden, 1),
+        )
+        self.distance_temperature_logit = nn.Parameter(torch.tensor(-1.0986123))
+
+    def reset_adapter_parameters(self) -> None:
+        nn.init.zeros_(self.route_gate[-1].weight)
+        nn.init.constant_(self.route_gate[-1].bias, 0.0)
+        with torch.no_grad():
+            self.distance_temperature_logit.fill_(-1.0986123)
+
+    def forward(
+        self,
+        sequence_output: torch.Tensor,
+        context: torch.Tensor,
+        retrieved_x: torch.Tensor,
+        retrieved_y: torch.Tensor,
+        distances: torch.Tensor,
+    ) -> tuple[torch.Tensor, torch.Tensor]:
+        del context, retrieved_x
+        if sequence_output.ndim != 3 or sequence_output.shape[1] != 1:
+            raise ValueError("DQR sequence_output must have shape [B,1,D]")
+        if retrieved_y.ndim != 3 or distances.shape != retrieved_y.shape[:2]:
+            raise ValueError("DQR retrieved futures/distances have incompatible shapes")
+
+        query_hidden = sequence_output[:, 0, :]
+        candidate_tokens = self.future_projector(retrieved_y)
+        tokens = torch.cat((sequence_output, candidate_tokens), dim=1)
+        att_output, _ = self.set_attention(tokens, tokens, tokens, need_weights=False)
+        tokens = tokens + att_output
+        tokens = tokens + self.set_ffn(tokens)
+
+        query_token = tokens[:, :1, :]
+        candidates = tokens[:, 1:, :]
+        z_distance = distances.to(dtype=candidates.dtype)
+        z_distance = (z_distance - z_distance.mean(dim=1, keepdim=True)) / (
+            z_distance.std(dim=1, keepdim=True, unbiased=False).clamp_min(1e-6)
+        )
+        query_expanded = query_token.expand_as(candidates)
+        relation_logits = self.relation_score(
+            torch.cat(
+                (query_expanded, candidates, candidates - query_expanded,
+                 z_distance[..., None]),
+                dim=-1,
+            )
+        ).squeeze(-1)
+        distance_temperature = F.softplus(self.distance_temperature_logit) + 1e-4
+        relation_logits = relation_logits - distance_temperature * z_distance
+        query_logits = self.query_score(query_token[:, 0, :]).squeeze(-1)
+        logits = torch.cat((query_logits[:, None], relation_logits), dim=1)
+        weights = torch.softmax(logits, dim=1)
+        routed = torch.sum(weights[..., None] * tokens, dim=1)
+        spread = (candidates - candidates.mean(dim=1, keepdim=True)).square().mean(dim=(1, 2)).sqrt()
+        distance_spread = z_distance.std(dim=1, unbiased=False)
+        gate_input = torch.cat(
+            (query_hidden, routed, spread[:, None], distance_spread[:, None]), dim=-1
+        )
+        gate = torch.sigmoid(self.route_gate(gate_input))
+        # Full-width route residual: no tanh clipping of the representation.
+        fused = query_hidden + gate * routed
+        return fused[:, None, :], weights[:, None, :]
+
+
+class RelationalExpertMixerAdapter(nn.Module):
+    """Query-anchor expert mixer with relational candidate admission.
+
+    REM keeps a full-width set mixer and the original query skip connection,
+    but replaces the official independent per-token sigmoid gates with one
+    joint softmax over the query expert and retrieved experts.  Candidate
+    logits depend on query state, candidate state, their difference and the
+    normalized retrieval distance, making the module structurally distinct
+    while avoiding a second unconstrained residual gate.
+    """
+
+    def __init__(
+        self,
+        d_model: int,
+        prediction_length: int = 64,
+        relation_hidden: int = 128,
+        num_heads: int = 8,
+    ) -> None:
+        super().__init__()
+        self.d_model = int(d_model)
+        self.prediction_length = int(prediction_length)
+        hidden = int(relation_hidden)
+        self.future_projector = nn.Sequential(
+            nn.Linear(self.prediction_length, self.d_model),
+            nn.ReLU(),
+            nn.Linear(self.d_model, self.d_model),
+        )
+        self.set_attention = nn.MultiheadAttention(
+            embed_dim=self.d_model,
+            num_heads=int(num_heads),
+            batch_first=True,
+        )
+        self.set_ffn = nn.Sequential(
+            nn.Linear(self.d_model, self.d_model),
+            nn.ReLU(),
+            nn.Linear(self.d_model, self.d_model),
+        )
+        self.relation_score = nn.Sequential(
+            nn.Linear(self.d_model * 3 + 1, hidden),
+            nn.GELU(),
+            nn.Linear(hidden, 1),
+        )
+        self.query_score = nn.Sequential(
+            nn.Linear(self.d_model, hidden),
+            nn.GELU(),
+            nn.Linear(hidden, 1),
+        )
+        self.distance_temperature_logit = nn.Parameter(torch.tensor(-1.0986123))
+        self.dropout = nn.Dropout(p=0.2)
+
+    def reset_adapter_parameters(self) -> None:
+        with torch.no_grad():
+            self.distance_temperature_logit.fill_(-1.0986123)
+
+    def forward(
+        self,
+        sequence_output: torch.Tensor,
+        context: torch.Tensor,
+        retrieved_x: torch.Tensor,
+        retrieved_y: torch.Tensor,
+        distances: torch.Tensor,
+    ) -> tuple[torch.Tensor, torch.Tensor]:
+        del context, retrieved_x
+        if sequence_output.ndim != 3 or sequence_output.shape[1] != 1:
+            raise ValueError("REM sequence_output must have shape [B,1,D]")
+        if retrieved_y.ndim != 3 or distances.shape != retrieved_y.shape[:2]:
+            raise ValueError("REM retrieved futures/distances have incompatible shapes")
+
+        candidate_tokens = self.future_projector(retrieved_y)
+        all_tokens = torch.cat((sequence_output, candidate_tokens), dim=1)
+        att_output, _ = self.set_attention(
+            all_tokens, all_tokens, all_tokens, need_weights=False
+        )
+        all_tokens = all_tokens + att_output
+        all_tokens = all_tokens + self.dropout(self.set_ffn(all_tokens))
+
+        query_token = all_tokens[:, :1, :]
+        candidates = all_tokens[:, 1:, :]
+        z_distance = distances.to(dtype=candidates.dtype)
+        z_distance = (z_distance - z_distance.mean(dim=1, keepdim=True)) / (
+            z_distance.std(dim=1, keepdim=True, unbiased=False).clamp_min(1e-6)
+        )
+        query_expanded = query_token.expand_as(candidates)
+        candidate_logits = self.relation_score(
+            torch.cat(
+                (query_expanded, candidates, candidates - query_expanded,
+                 z_distance[..., None]),
+                dim=-1,
+            )
+        ).squeeze(-1)
+        distance_temperature = F.softplus(self.distance_temperature_logit) + 1e-4
+        candidate_logits = candidate_logits - distance_temperature * z_distance
+        query_logits = self.query_score(query_token[:, 0, :]).squeeze(-1)
+        weights = torch.softmax(
+            torch.cat((query_logits[:, None], candidate_logits), dim=1), dim=1
+        )
+        routed = torch.sum(weights[..., None] * all_tokens, dim=1)
+        fused = sequence_output[:, 0, :] + self.dropout(routed)
+        return fused[:, None, :], weights[:, None, :]
+
+
+class ChronosBoltModelForForecastingWithRetrieval(T5PreTrainedModel):
+    _keys_to_ignore_on_load_missing = [
+        r"input_patch_embedding\.",
+        r"output_patch_embedding\.",
+    ]
+    _keys_to_ignore_on_load_unexpected = [r"lm_head.weight"]
+    _tied_weights_keys = ["encoder.embed_tokens.weight", "decoder.embed_tokens.weight"]
+
+    def __init__(self, config: T5Config, augment: str, enable_mi_gra: bool = False,
+                 mi_gra_hidden_dim: int = 64):
+        assert hasattr(config, "chronos_config"), "Not a Chronos config file"
+
+        super().__init__(config)
+        self.model_dim = config.d_model
+        self.augment = augment
+        self.enable_mi_gra = bool(enable_mi_gra)
+        self.mi_gra_hidden_dim = int(mi_gra_hidden_dim)
+
+        # TODO: remove filtering eventually, added for backward compatibility
+        config_fields = {f.name for f in fields(ChronosBoltConfig)}
+        self.chronos_config = ChronosBoltConfig(
+            **{k: v for k, v in config.chronos_config.items() if k in config_fields}
+        )
+
+        # Only decoder_start_id (and optionally REG token)
+        if self.chronos_config.use_reg_token:
+            config.reg_token_id = 1
+
+        config.vocab_size = 2 if self.chronos_config.use_reg_token else 1
+        self.shared = nn.Embedding(config.vocab_size, config.d_model)
+
+        # Input patch embedding layer
+        self.input_patch_embedding = ResidualBlock(
+            in_dim=self.chronos_config.input_patch_size * 2,
+            h_dim=config.d_ff,
+            out_dim=config.d_model,
+            act_fn_name=config.dense_act_fn,
+            dropout_p=config.dropout_rate,
+        )
+
+        # patching layer
+        self.patch = Patch(
+            patch_size=self.chronos_config.input_patch_size,
+            patch_stride=self.chronos_config.input_patch_stride,
+        )
+
+        # instance normalization, also referred to as "scaling" in Chronos and GluonTS
+        self.instance_norm = InstanceNorm()
+
+        encoder_config = copy.deepcopy(config)
+        encoder_config.is_decoder = False
+        encoder_config.use_cache = False
+        encoder_config.is_encoder_decoder = False
+        self.encoder = T5Stack(encoder_config, self.shared)
+
+        self._init_decoder(config)
+
+        self.num_quantiles = len(self.chronos_config.quantiles)
+        quantiles = torch.tensor(self.chronos_config.quantiles, dtype=self.dtype)
+        self.register_buffer("quantiles", quantiles, persistent=False)
+
+        self.output_patch_embedding = ResidualBlock(
+            in_dim=config.d_model,
+            h_dim=config.d_ff,
+            out_dim=self.num_quantiles * self.chronos_config.prediction_length,
+            act_fn_name=config.dense_act_fn,
+            dropout_p=config.dropout_rate,
+        )
+
+        self.dropout = nn.Dropout(p=0.2)
+
+        # Retrieval Augmentation Layer
+
+        if 'gate' in self.augment:
+            # gate: MLP + Linear
+            self.gate_layer = nn.Sequential(
+                nn.Linear(self.chronos_config.prediction_length * 2 + 512 + 12, config.d_model),
+                nn.ReLU(),
+                nn.Linear(config.d_model, config.d_model),
+            )
+            self.gate_linear1 = nn.Linear(self.chronos_config.prediction_length * 2 + 512 + 12, config.d_model)
+            self.gate_linear2 = nn.Linear(config.d_model, 1)
+
+        if 'moe' in self.augment:
+            # moe: moe with topk+1 experts, use mha
+            self.encode_mlp = nn.Sequential(
+                nn.Linear(self.chronos_config.prediction_length, config.d_model),
+                nn.ReLU(),
+                nn.Linear(config.d_model, config.d_model),
+            )
+            self.mha = nn.MultiheadAttention(embed_dim=config.d_model, num_heads=8, batch_first=True)
+            self.ffn = nn.Sequential(
+                nn.Linear(config.d_model, config.d_model),
+                nn.ReLU(),
+                nn.Linear(config.d_model, config.d_model),
+            )
+            self.gate_layer = nn.Sequential(
+                nn.Linear(config.d_model, config.d_model),
+                nn.ReLU(),
+                nn.Linear(config.d_model, 1),
+            )
+
+        if self.augment == 'rcam':
+            # Cross-RAG (the ARM replacement from arXiv:2603.14709).  Query
+            # history and retrieved futures are encoded separately: the
+            # retrieved history is the cross-attention key and the retrieved
+            # future is the value.  A second self-attention branch aggregates
+            # the retrieved futures before the fixed lambda mix.
+            self.rcam_projector_x = nn.Sequential(
+                nn.Linear(self.chronos_config.context_length, config.d_model),
+                nn.ReLU(),
+                nn.Linear(config.d_model, config.d_model),
+            )
+            self.rcam_projector_y = nn.Sequential(
+                nn.Linear(self.chronos_config.prediction_length, config.d_model),
+                nn.ReLU(),
+                nn.Linear(config.d_model, config.d_model),
+            )
+            self.rcam_cross_mha = nn.MultiheadAttention(
+                embed_dim=config.d_model,
+                num_heads=8,
+                batch_first=True,
+            )
+            self.rcam_self_mha = nn.MultiheadAttention(
+                embed_dim=config.d_model,
+                num_heads=8,
+                batch_first=True,
+            )
+            self.rcam_cross_ffn = nn.Sequential(
+                nn.Linear(config.d_model, config.d_model),
+                nn.ReLU(),
+                nn.Linear(config.d_model, config.d_model),
+            )
+            self.rcam_self_ffn = nn.Sequential(
+                nn.Linear(config.d_model, config.d_model),
+                nn.ReLU(),
+                nn.Linear(config.d_model, config.d_model),
+            )
+            self.rcam_lambda = 0.7
+
+        if self.augment == 'trfa':
